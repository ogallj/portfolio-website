---
import Arrow from './Arrow.astro';
import { featuredCreativeWork } from '../data/creative-work';
---
  <dialog class="artwork-dialog" id="creative-artwork-viewer" data-artwork-dialog aria-labelledby="artwork-view-title" aria-describedby="artwork-view-meta">
    <header><div><h2 id="artwork-view-title" data-artwork-title>Creative work</h2><p id="artwork-view-meta" data-artwork-meta></p></div><button type="button" data-artwork-close aria-label="Close artwork viewer" autofocus><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button></header>
    <figure class="artwork-view"><img data-artwork-image src={featuredCreativeWork[0].src} alt={featuredCreativeWork[0].alt} width={featuredCreativeWork[0].width} height={featuredCreativeWork[0].height} loading="lazy" decoding="async" /></figure>
    <footer><p class="artwork-status" data-artwork-status role="status"></p><a href="#" data-artwork-original target="_blank" rel="noreferrer">Open original <Arrow /></a><div class="artwork-controls"><button type="button" data-artwork-previous aria-label="Previous artwork"><Arrow diagonal={false} /></button><span data-artwork-position aria-live="polite"></span><button type="button" data-artwork-next aria-label="Next artwork"><Arrow diagonal={false} /></button></div></footer>
  </dialog>
<style>
  .artwork-dialog { inset:0;margin:auto;width:min(1300px,calc(100vw - 40px));height:calc(100dvh - 40px);max-width:none;max-height:none;padding:24px;border:0;background:#101820;color:#edf1f2;overflow:hidden;--focus:#bfd2c2; }
  .artwork-dialog[open] { display:grid;grid-template-rows:auto minmax(0,1fr) auto;gap:18px; }
  .artwork-dialog::backdrop { background:#08110fe8; }
  :global(html:has(dialog[data-artwork-dialog][open])) { overflow:hidden; }
  .artwork-dialog > header { display:flex;justify-content:space-between;align-items:start;gap:25px; }
  .artwork-dialog > header > div { min-width:0; }
  .artwork-dialog h2 { font-size:clamp(20px,2.2vw,30px);line-height:1.2;letter-spacing:-.025em; }
  .artwork-dialog > header p { margin-top:7px;font-size:11px;color:#b7c8bf;line-height:1.6; }
  .artwork-dialog button { display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;width:44px;height:44px;border:1px solid #53645f;border-radius:50%;background:transparent;color:inherit; }
  .artwork-dialog button svg { width:19px;height:19px; }
  .artwork-view { display:flex;align-items:center;justify-content:center;min-width:0;min-height:0; }
  .artwork-view img { display:block;max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain; }
  .artwork-dialog > footer { display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:8px 22px; }
  .artwork-status { grid-column:1 / -1;min-height:18px;color:#b7c8bf;font-size:11px;line-height:1.6; }
  .artwork-dialog > footer > a { display:inline-flex;align-items:center;gap:14px;min-height:44px;width:fit-content;font-size:11px; }
  .artwork-dialog > footer > a :global(.arrow-icon) { width:14px;height:14px; }
  .artwork-controls { display:flex;align-items:center;gap:14px; }
  .artwork-controls > span { min-width:42px;font-size:11px;line-height:1.6;text-align:center;font-variant-numeric:tabular-nums; }
  .artwork-controls button:first-child :global(.arrow-icon) { transform:rotate(180deg); }

@media (hover:hover) and (pointer:fine) { .artwork-dialog a:hover { text-decoration:underline;text-underline-offset:5px; }.artwork-dialog button:hover { background:#253b30; } }
@media(max-width:750px) { .artwork-dialog { width:calc(100vw - 20px);height:calc(100dvh - 20px);padding:14px; }.artwork-dialog[open] { gap:12px; }.artwork-dialog h2 { font-size:20px; }.artwork-dialog > header p { font-size:10px; }.artwork-dialog > footer { column-gap:12px; }.artwork-controls { gap:8px; }.artwork-controls > span { min-width:35px;font-size:10px; }.artwork-dialog > footer > a { font-size:10px;gap:9px; } }
</style>
