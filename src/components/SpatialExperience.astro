---
import Arrow from './Arrow.astro';
import type { SpatialKind, SpatialAsset } from '../scripts/spatial/types';
interface Props {
  kind: SpatialKind;
  title: string[];
  description: string;
  assets?: SpatialAsset[];
  poster?: string;
  actions?: { href: string; label: string; download?: string }[];
  choices?: { id: string; label: string }[];
  target: string;
  hold?: number;
  theme?: 'light' | 'dark';
  caption?: string;
}
const { kind, title, description, assets = [], poster = assets[0]?.src, actions = [], choices = [], target, hold = 1.15, theme = 'dark', caption = '' } = Astro.props;
const destination = target.startsWith('#') || target.startsWith('/') ? target : `#${target}`;
const compactLabel = (label:string) => { const short=label.replace(/^Explore |^Download /,'');return short.charAt(0).toUpperCase()+short.slice(1); };
---
<section class:list={['spatial-experience', `spatial-experience--${kind}`, { 'spatial-experience--light': theme === 'light' }]} data-spatial-root data-spatial-kind={kind} data-spatial-assets={JSON.stringify(assets)} data-spatial-hold={hold} data-spatial-selection={choices[0]?.id || assets[0]?.id || ''} aria-labelledby={`spatial-${kind}-title`}>
  <div class="spatial-stage" data-spatial-stage>
    <div class="spatial-art" aria-hidden="true">
      <div class="spatial-poster" data-spatial-poster>
        {poster ? <img src={poster} alt="" width={assets[0]?.width || 1000} height={assets[0]?.height || 1000} fetchpriority="high" decoding="async" /> : kind === 'missing' ? <svg viewBox="0 0 600 480" fill="none"><path d="M115 100h310v60H175v220h-60zM175 320h310v60H175z" fill="#c6dadb"/><path d="M465 160h60v100h-60z" fill="#88adb4"/></svg> : <svg viewBox="0 0 600 480" fill="none"><path d="m85 180 215-140 215 140v240H85Z" fill="#c4d4d6"/><path d="M110 180h380v225H110Z" fill="#f3f4ed"/><path d="m85 180 215 160 215-160v240H85Z" fill="#dbe5e5"/><path d="m85 420 215-160 215 160" fill="#eaf0ee"/></svg>}
      </div>
      <div class="spatial-renderer" data-spatial-mount></div>
    </div>
    <div class="spatial-copy">
      <h1 id={`spatial-${kind}-title`}>{title.map(line => <span>{line}</span>)}</h1>
      <p class="spatial-description">{description}</p>
      <div class="spatial-actions">{actions.map(action => <a href={action.href} download={action.download}><span class="spatial-action-full">{action.label}</span><span class="spatial-action-compact">{compactLabel(action.label)}</span><Arrow /></a>)}</div>
      {choices.length > 0 && <div class="spatial-choices" role="group" aria-label="Choose a perspective">{choices.map((choice,index) => <button type="button" data-spatial-choice={choice.id} aria-pressed={index === 0 ? 'true' : 'false'} disabled>{choice.label}</button>)}</div>}
    </div>
    <div class="spatial-bottom"><span>{caption}</span><a href={destination}>Explore <Arrow diagonal={false} /></a></div>
  </div>
</section>
<script>
  import { initSpatialExperiences } from '../scripts/spatial-director';
  initSpatialExperiences();
</script>
<style>
  .spatial-experience { --spatial-bg:#101c2a;--spatial-ink:#f0f4f3;--spatial-muted:#c0ccd5;--focus:#bed1ff;background:var(--spatial-bg);color:var(--spatial-ink);position:relative;isolation:isolate; }
  .spatial-experience--light { --spatial-bg:#e2e8e5;--spatial-ink:#172128;--spatial-muted:#42585e;--focus:#284cf2; }
  .spatial-stage { position:relative;min-height:max(740px,100svh);overflow:hidden;isolation:isolate; }
  .spatial-art { position:absolute;inset:0;z-index:-1;pointer-events:none; }
  .spatial-poster { position:absolute;inset:14% 3% 12% 44%;display:grid;place-items:center; }
  .spatial-poster img { width:100%;height:100%;object-fit:contain; }
  .spatial-poster svg { width:100%;max-height:100%; }
  .spatial-renderer { position:absolute;inset:0;opacity:0; }
  .spatial-renderer :global(canvas) { width:100%;height:100%;display:block; }
  .spatial-experience[data-spatial-ready='true'] .spatial-renderer { opacity:1; }
  .spatial-experience[data-spatial-ready='true'] .spatial-poster { opacity:0; }
  .spatial-copy { position:relative;padding:clamp(150px,19vh,220px) var(--gutter) 115px;min-height:100svh;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;max-width:52%; }
  .spatial-copy h1 { font:450 clamp(49px,5.8vw,94px)/.98 var(--display);letter-spacing:-.06em;text-wrap:initial;max-width:100%;overflow-wrap:normal; }
  .spatial-copy h1 span { display:block; }
  .spatial-copy h1 span+span { margin-top:3px; }
  .spatial-experience--project .spatial-copy h1 { font-size:clamp(40px,5vw,80px); }
  .spatial-description { max-width:32ch;font-size:clamp(16px,1.3vw,20px);line-height:1.55;color:var(--spatial-muted);margin-top:28px; }
  .spatial-actions { display:flex;flex-wrap:wrap;gap:0 24px;max-width:410px;margin-top:26px; }
  .spatial-actions a { display:inline-flex;align-items:center;gap:16px;min-height:46px;font-size:13px;font-weight:600; }
  .spatial-action-compact { display:none; }
  .spatial-actions :global(.arrow-icon) { width:17px;height:17px; }
  .spatial-choices { display:flex;gap:6px;padding:5px;background:#ffffff0c;margin-top:25px; }
  .spatial-choices button { border:0;background:transparent;color:var(--spatial-muted);min-height:44px;min-width:70px;padding:9px 17px;font-size:12px;transition:background 180ms ease,color 180ms ease; }
  .spatial-choices button[aria-pressed='true'] { background:var(--spatial-ink);color:var(--spatial-bg); }
  .spatial-choices button:disabled { cursor:default; }
  .spatial-experience--light .spatial-choices { background:#17212809; }
  .spatial-bottom { position:absolute;bottom:26px;left:var(--gutter);right:var(--gutter);display:flex;align-items:center;justify-content:space-between;gap:30px;padding-right:150px;font-size:11px;color:var(--spatial-muted); }
  .spatial-bottom > span { max-width:45ch; }
  .spatial-bottom a { display:inline-flex;align-items:center;gap:15px;min-height:44px;color:var(--spatial-ink); }
  .spatial-bottom :global(.arrow-icon) { width:17px;height:17px;transform:rotate(90deg); }
  .spatial-experience[data-spatial-enhanced='true'] { height:var(--spatial-height,215svh); }
  .spatial-experience[data-spatial-enhanced='true'] .spatial-stage { position:sticky;top:0;height:100svh; }
  @media (min-width:1001px) {
    .spatial-experience--creative .spatial-copy { position:absolute;left:0;right:0;bottom:85px;min-height:0;max-width:none;padding:0 var(--gutter);display:grid;grid-template-columns:1fr 1fr;gap:0 9%; }
    .spatial-experience--creative .spatial-copy h1 { grid-column:1/-1;font-size:clamp(58px,6.2vw,100px); }
    .spatial-experience--creative .spatial-copy h1 span { display:inline; }
    .spatial-experience--creative .spatial-copy h1 span+span::before { content:' '; }
    .spatial-experience--creative .spatial-description { grid-column:1;max-width:42ch;font-size:16px;margin-top:22px; }
    .spatial-experience--creative .spatial-actions { grid-column:2;align-self:center;justify-self:end;justify-content:flex-end;margin-top:22px; }
    .spatial-experience--creative .spatial-choices { position:absolute;left:var(--gutter);bottom:calc(100% + 18px);margin:0; }
    .spatial-experience--about .spatial-copy { position:absolute;left:0;right:0;bottom:100px;min-height:0;max-width:none;padding:0 var(--gutter);display:grid;grid-template-columns:1.2fr 1fr;column-gap:9%; }
    .spatial-experience--about .spatial-copy h1 { grid-column:1;font-size:clamp(65px,6.6vw,100px); }
    .spatial-experience--about .spatial-copy h1 span { display:inline; }
    .spatial-experience--about .spatial-copy h1 span+span::before { content:' '; }
    .spatial-experience--about .spatial-description { grid-column:2;grid-row:1/3;align-self:center;margin:0;font-size:17px; }
    .spatial-experience--about .spatial-actions { grid-column:1;margin-top:15px; }
    .spatial-experience--contact .spatial-copy { margin-left:52%;max-width:48%;padding-left:35px; }
  }
  @media (hover:hover) and (pointer:fine) { .spatial-actions a:hover,.spatial-bottom a:hover { text-decoration:underline;text-underline-offset:6px; } .spatial-choices button:not([aria-pressed='true']):not(:disabled):hover { background:#b3c6cf20; } }
  @media (min-width:701px) and (max-width:1000px) { .spatial-copy { max-width:56%; }.spatial-copy h1 { font-size:clamp(43px,6vw,60px); }.spatial-description { font-size:16px;max-width:25ch; }.spatial-actions { gap:0 20px; }.spatial-actions a { font-size:12px; } }
  @media (max-width:700px) {
    .spatial-stage { min-height:max(740px,100svh); }
    .spatial-art { position:relative;inset:auto;margin-top:78px;height:clamp(260px,45svh,460px); }
    .spatial-poster { inset:8% 12%; }
    .spatial-copy { position:relative;inset:auto;min-height:0;padding:20px var(--gutter) 105px;max-width:none;justify-content:flex-end; }
    .spatial-copy h1 { font-size:clamp(40px,12.5vw,67px);line-height:.98; }
    .spatial-experience--project .spatial-copy h1 { font-size:clamp(32px,10.2vw,52px); }
    .spatial-description { font-size:13px;line-height:1.5;max-width:40ch;margin-top:20px; }
    .spatial-actions { gap:0 16px;margin-top:14px; }.spatial-actions a { font-size:11px;gap:0;min-height:44px;text-decoration:underline;text-underline-offset:5px; }
    .spatial-actions :global(.arrow-icon) { display:none; }
    .spatial-action-full { display:none; }.spatial-action-compact { display:inline; }
    .spatial-choices { position:relative;inset:auto;margin-top:12px; }.spatial-choices button { font-size:11px;padding:8px 15px;min-height:44px; }
    .spatial-bottom { bottom:18px;padding-right:125px;font-size:10px; }
    .spatial-bottom > span { display:none; }
    .spatial-experience[data-spatial-enhanced='true'] .spatial-stage { min-height:0; }
    .spatial-experience[data-spatial-enhanced='true'] .spatial-copy { position:absolute;left:0;right:0;bottom:85px;min-height:0;padding:0 var(--gutter); }
    .spatial-experience[data-spatial-enhanced='true'] .spatial-art { position:absolute;inset:78px 0 auto;margin:0;height:var(--spatial-art-height,45%); }
    .spatial-experience[data-spatial-enhanced='true'] .spatial-choices { position:absolute;bottom:calc(100% + 20px);right:var(--gutter);margin:0; }
  }
  @media (max-height:650px) and (min-width:701px) { .spatial-copy { padding-top:130px; }.spatial-copy h1 { font-size:54px; }.spatial-description { margin-top:20px;font-size:15px; }.spatial-choices { margin-top:12px; } }
</style>
