---
import BrandMark from './BrandMark.astro';
import { logoAssets, cocaColaMarks, ungaFoodMarks, ungaFarmcareMarks } from '../data/brand-logos';

const nameOf = (id: string) => logoAssets.find(mark => mark.id === id)!.name;
const divisions = [
  { id: 'unga-limited', title: 'Food & nutrition', marks: ungaFoodMarks },
  { id: 'unga-farmcare', title: 'FarmCare', marks: ungaFarmcareMarks },
];
---
<div class="brand-families frame">
  <article class="bf-family" aria-labelledby="coca-family-title">
    <header class="bf-parent">
      <div class="bf-parent-mark bf-parent-mark--coca"><BrandMark id="coca-cola-africa" decorative /></div>
      <div class="bf-parent-copy">
        <h3 id="coca-family-title">Coca-Cola Africa</h3>
        <p>Brand experience across the beverage portfolio.</p>
      </div>
    </header>
    <div class="bf-portfolio">
      <p class="bf-group-label">Within the brand family</p>
      <ul class="bf-brand-register bf-brand-register--beverages" aria-label="Brands within the Coca-Cola Africa family">
        {cocaColaMarks.map(id => <li><div class="bf-product-mark"><BrandMark id={id} decorative /></div><span>{nameOf(id)}</span></li>)}
      </ul>
      <p class="bf-contribution">Includes creative work and ideation for Fanta's Skizia Utamu Challenge.</p>
    </div>
  </article>

  <article class="bf-family bf-family--unga" aria-labelledby="unga-family-title">
    <header class="bf-parent">
      <div class="bf-parent-mark bf-parent-mark--unga"><BrandMark id="unga" decorative /></div>
      <div class="bf-parent-copy">
        <h3 id="unga-family-title">UNGA Group</h3>
        <p>Two divisions, with their respective product brands.</p>
      </div>
    </header>
    <div class="bf-divisions">
      {divisions.map(division => <section class="bf-division" id={division.id} aria-labelledby={division.id + '-title'}>
        <header class="bf-division-heading">
          <div class="bf-division-mark"><BrandMark id={division.id} /></div>
          <h4 id={division.id + '-title'}>{division.title}</h4>
        </header>
        <ul class="bf-brand-register" aria-label={nameOf(division.id) + ' brands'}>
          {division.marks.map(id => <li><div class="bf-product-mark"><BrandMark id={id} decorative /></div><span>{nameOf(id)}</span></li>)}
        </ul>
      </section>)}
    </div>
  </article>
</div>

<style>
  .brand-families { min-width: 0; max-width: 1600px; margin-inline: auto; background: #fff; color: var(--ink, #262d2b); }
  .bf-family { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.7fr); gap: clamp(45px, 7.5vw, 120px); padding-block: clamp(55px, 6.5vw, 95px); }
  .bf-family + .bf-family { border-top: 1px solid var(--line, #d0d7d0); }
  .bf-parent,.bf-portfolio,.bf-divisions,.bf-division { min-width: 0; }
  .bf-parent-mark { display: flex; align-items: center; justify-content: flex-start; min-height: 100px; margin-bottom: 28px; }
  .bf-parent-mark :global(.brand-mark) { display: block; width: 100%; height: auto; object-fit: contain; object-position: left center; }
  .bf-parent-mark--coca :global(.brand-mark) { max-width: 300px; max-height: 95px; }
  .bf-parent-mark--unga { min-height: 122px; }
  .bf-parent-mark--unga :global(.brand-mark) { max-width: 225px; max-height: 123px; }
  .bf-parent-copy h3 { font: 430 clamp(27px, 2.6vw, 39px)/1.12 var(--display); letter-spacing: -.045em; scroll-margin-top: 110px; text-wrap: initial; }
  .bf-parent-copy p { max-width: 28ch; margin-top: 15px; font-size: 13px; line-height: 1.75; color: var(--muted, #626c66); }
  .bf-group-label { margin-bottom: 35px; font-size: 11px; line-height: 1.6; color: var(--muted, #626c66); }
  .bf-brand-register { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 30px 25px; padding: 0; margin: 0; list-style: none; }
  .bf-brand-register--beverages { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .bf-brand-register > li { min-width: 0; }
  .bf-product-mark { display: flex; align-items: center; justify-content: flex-start; height: 60px; margin-bottom: 13px; }
  .bf-product-mark :global(.brand-mark) { display: block; width: 100%; max-width: 100px; height: 44px; object-fit: contain; object-position: left center; }
  .bf-product-mark :global(.brand-mark--compact) { max-width: 40px; }
  .bf-brand-register--beverages .bf-product-mark { height: 72px; }
  .bf-brand-register--beverages .bf-product-mark :global(.brand-mark) { max-width: 110px; height: 58px; }
  .bf-brand-register > li > span { display: block; font-size: 11px; line-height: 1.55; color: var(--muted, #626c66); overflow-wrap: anywhere; }
  .bf-contribution { max-width: 57ch; margin-top: 38px; font-size: 11px; line-height: 1.75; color: var(--muted, #626c66); }
  .bf-divisions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(35px, 4vw, 65px); }
  .bf-division { scroll-margin-top: 110px; }
  .bf-division-heading { padding-bottom: 23px; margin-bottom: 25px; border-bottom: 1px solid var(--line, #d0d7d0); }
  .bf-division-mark { display: flex; align-items: center; min-height: 58px; margin-bottom: 19px; }
  .bf-division-mark :global(.brand-mark) { display: block; width: 100%; max-width: 150px; height: 48px; object-fit: contain; object-position: left center; }
  .bf-division-heading h4 { font: 450 20px/1.3 var(--display); letter-spacing: -.025em; }
  @media (max-width: 1150px) {
    .bf-family { grid-template-columns: minmax(0, .8fr) minmax(0, 1.6fr); gap: 50px; }
    .bf-divisions { gap: 35px; }
    .bf-division .bf-brand-register { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bf-brand-register--beverages { gap: 25px 20px; }
  }
  @media (max-width: 900px) {
    .bf-family { grid-template-columns: 1fr; gap: 40px; padding-block: 55px; }
    .bf-parent { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 40px; align-items: center; }
    .bf-parent-mark { margin: 0; }
    .bf-parent-copy h3 { font-size: 30px; }
    .bf-parent-copy p { max-width: 34ch; }
    .bf-division .bf-brand-register { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .bf-group-label { margin-bottom: 24px; }
    .bf-contribution { margin-top: 30px; }
  }
  @media (max-width: 600px) {
    .bf-family { padding-block: 45px; gap: 32px; }
    .bf-parent { display: block; }
    .bf-parent-mark { min-height: 0; margin-bottom: 24px; }
    .bf-parent-mark--coca :global(.brand-mark) { max-width: 260px; max-height: 65px; }
    .bf-parent-mark--unga :global(.brand-mark) { max-width: 205px; max-height: 112px; }
    .bf-parent-copy h3 { font-size: 29px; }
    .bf-parent-copy p { font-size: 12px; margin-top: 12px; }
    .bf-brand-register--beverages { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .bf-brand-register { gap: 27px 22px; }
    .bf-product-mark { height: 53px; margin-bottom: 10px; }
    .bf-product-mark :global(.brand-mark) { max-width: 94px; height: 39px; }
    .bf-brand-register--beverages .bf-product-mark { height: 60px; }
    .bf-brand-register--beverages .bf-product-mark :global(.brand-mark) { max-width: 102px; height: 50px; }
    .bf-contribution { font-size: 11px; margin-top: 27px; }
    .bf-divisions { grid-template-columns: 1fr; gap: 40px; }
    .bf-division-heading { display: flex; align-items: center; justify-content: space-between; gap: 25px; padding-bottom: 20px; margin-bottom: 22px; }
    .bf-division-mark { flex: 0 1 145px; min-width: 0; min-height: 50px; margin: 0; }
    .bf-division-mark :global(.brand-mark) { max-width: 145px; height: 45px; }
    .bf-division-heading h4 { max-width: 140px; font-size: 19px; }
  }
  @media (max-width: 360px) {
    .bf-parent-copy h3 { font-size: 27px; }
    .bf-brand-register { column-gap: 18px; }
    .bf-division-heading { gap: 18px; }
    .bf-division-mark { flex-basis: 125px; }
    .bf-division-heading h4 { max-width: 115px; font-size: 18px; }
  }
</style>
