---
import Arrow from './Arrow.astro';
import ArtworkViewer from './ArtworkViewer.astro';
import { creativeWork, creativeCategories, creativeKindLabel } from '../data/creative-work';
interface Props { category?: string }
const { category = 'all' } = Astro.props;
const selected = creativeCategories.find(item => item.key === category);
const pieces = selected ? creativeWork.filter(piece => piece.kind === selected.key) : creativeWork;
---
<section class="creative-catalog frame" id="collection" data-creative-gallery data-work-catalog data-work-category={category} aria-labelledby="collection-title">
  <header class="catalog-heading"><a class="catalog-back" href="/creative-marketing/#creative-work"><Arrow diagonal={false} />Creative &amp; marketing</a><h1 id="collection-title">{selected ? selected.label + '.' : 'The creative collection.'}</h1><div><p>{selected ? `${pieces.length} pieces in ${selected.label.toLowerCase()}.` : `${creativeWork.length} pieces across campaign creative, identity boards and brand content.`} Open any artwork for a closer look.</p><a href="/creative-marketing/#brand-experience">Brand experience <Arrow /></a></div></header>
  <nav class="catalog-categories" aria-label="Creative work categories"><a href="/creative-marketing/work/" aria-current={category === 'all' ? 'page' : undefined}>All work <span>{creativeWork.length}</span></a>{creativeCategories.map(item => <a href={item.href} aria-current={category === item.key ? 'page' : undefined}>{item.label}<span>{item.count}</span></a>)}</nav>
  <ul class="catalog-grid" aria-label={selected ? selected.label : 'All creative work'}>{pieces.map(piece => <li data-work-card data-work-kind={piece.kind}><a href={piece.sourceHref} data-artwork-open={piece.id} aria-label={'Open artwork: ' + piece.brand + ' — ' + piece.title}><img src={piece.src} srcset={piece.sources.map(source => `${source.src} ${source.width}w`).join(', ')} sizes="(max-width: 600px) calc(100vw - 44px), (max-width: 1000px) 45vw, 23vw" width={piece.width} height={piece.height} alt={piece.alt} loading="lazy" decoding="async" /><div><h2>{piece.title}</h2><p>{piece.brand} / {creativeKindLabel[piece.kind]}</p></div></a></li>)}</ul>
  <div class="catalog-close"><p>{pieces.length} pieces / {selected ? selected.label : 'Complete collection'}</p><a href="/creative-marketing/#creative-work">Back to the featured selection <Arrow diagonal={false} /></a></div>
  <ArtworkViewer />
</section>
<script>import { initCreativeGallery } from '../scripts/creative-gallery'; initCreativeGallery();</script>
<style>
  .creative-catalog { --ink:#26352d;--muted:#5b685e;--focus:#3b5c40;background:#fbfcf9;color:var(--ink);padding-top:135px;padding-bottom:85px; }
  :global(body[data-theme='creative']) { background:#fbfcf9; }
  .catalog-back { display:inline-flex;align-items:center;gap:16px;min-height:44px;font-size:12px;margin-bottom:35px; }
  .catalog-back :global(.arrow-icon) { width:16px;height:16px;transform:rotate(180deg); }
  .catalog-heading h1 { font-size:clamp(47px,6vw,90px);font-weight:430;line-height:1.05;letter-spacing:-.04em;max-width:20ch; }
  .catalog-heading > div { display:flex;align-items:end;justify-content:space-between;gap:35px;margin-top:27px; }
  .catalog-heading p { max-width:600px;color:var(--muted);font-size:14px;line-height:1.8; }
  .catalog-heading > div > a { display:inline-flex;align-items:center;gap:20px;min-height:44px;font-size:11px; }
  .catalog-heading > div :global(.arrow-icon) { width:15px;height:15px; }
  .catalog-categories { display:flex;flex-wrap:wrap;gap:10px;margin-top:38px;margin-bottom:45px; }
  .catalog-categories a { display:inline-flex;align-items:center;gap:17px;min-height:46px;padding:11px 18px;border:1px solid #bbc8b7;border-radius:26px;font-size:12px; }
  .catalog-categories a[aria-current] { background:#304c39;border-color:#304c39;color:#fbfcf9; }
  .catalog-categories span { font-size:10px;font-variant-numeric:tabular-nums; }
  .catalog-grid { columns:4 210px;column-gap:28px; }
  .catalog-grid > li { break-inside:avoid;margin-bottom:38px; }
  .catalog-grid a { display:block; }
  .catalog-grid img { width:100%;height:auto; }
  .catalog-grid a > div { margin-top:14px; }
  .catalog-grid h2 { font:550 12px/1.6 var(--body);letter-spacing:0;text-wrap:pretty; }
  .catalog-grid p { color:var(--muted);font-size:10px;line-height:1.8;margin-top:5px; }
  .catalog-close { display:flex;justify-content:space-between;align-items:center;gap:30px;margin-top:30px;padding-top:25px;border-top:1px solid #cbd4c8;font-size:11px; }
  .catalog-close > p { color:var(--muted); }
  .catalog-close a { display:inline-flex;align-items:center;gap:20px;min-height:44px; }
  .catalog-close :global(.arrow-icon) { width:16px;height:16px;transform:rotate(180deg); }
  @media(hover:hover) and (pointer:fine) { .catalog-categories a:not([aria-current]):hover { background:#e8eee4; }.catalog-grid a:hover h2,.catalog-back:hover,.catalog-heading a:hover,.catalog-close a:hover { text-decoration:underline;text-underline-offset:5px; } }
  @media(max-width:750px) { .creative-catalog { padding-top:110px;padding-bottom:60px; }.catalog-back { font-size:11px;margin-bottom:28px; }.catalog-heading h1 { font-size:clamp(43px,10vw,66px); }.catalog-heading > div { display:block;margin-top:24px; }.catalog-heading p { font-size:13px; }.catalog-heading > div > a { margin-top:12px; }.catalog-categories { gap:8px;margin-top:25px;margin-bottom:35px; }.catalog-categories a { font-size:11px;gap:12px;padding:10px 14px; }.catalog-grid { columns:2 145px;column-gap:20px; }.catalog-grid h2 { font-size:11px; }.catalog-grid p { font-size:9px; }.catalog-close { align-items:start;flex-direction:column;gap:12px; } }
  @media(max-width:360px) { .catalog-grid { columns:1; }.catalog-categories a { font-size:10px;gap:10px;padding-inline:12px; } }
</style>
