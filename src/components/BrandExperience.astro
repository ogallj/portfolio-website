---
import BrandMark from './BrandMark.astro';
import Arrow from './Arrow.astro';
import BrandFamilies from './BrandFamilies.astro';
import { logoAssets, organizationMarks, professionalMarks } from '../data/brand-logos';
const nameOf = (id: string) => logoAssets.find(mark => mark.id === id)!.name;
---
<section class="brand-showcase section-space" id="brand-experience" aria-labelledby="brand-experience-title">
  <div class="frame section-intro brand-showcase-intro">
    <h2 id="brand-experience-title" data-reveal>A world<br />of brands.</h2>
    <p data-reveal>Different voices. Different audiences. Brand experience across agency, in-house, and independent creative work.</p>
  </div>
  <BrandFamilies />
  <div class="organization-showcase frame">
    <div class="organization-heading"><h3>Across industries.<br />Across communities.</h3><p>A selection of the organizations<br />in my experience.</p></div>
    <ul class="organization-wall" aria-label="Selected organization logos">
      {organizationMarks.map(id => <li class="organization-mark" data-reveal><div class="organization-mark-stage"><BrandMark id={id} decorative /></div><span>{nameOf(id)}</span></li>)}
    </ul>
    <p class="brand-credit-note">Experience includes work through agencies and employers. Campaign scope and individual credits will accompany each project as the work is added.</p>
  </div>
</section>
<section class="team-showcase section-space frame" aria-labelledby="team-showcase-title">
  <div class="section-intro"><h2 id="team-showcase-title" data-reveal>Good work.<br />Different teams.</h2><div><p>My practice has grown through engineering teams, digital agencies, and independent freelance work.</p><a class="text-link" href="/about/#experience-title">Explore my experience <Arrow diagonal={false} /></a></div></div>
  <ul class="professional-marks">{professionalMarks.map(mark => <li data-reveal><div class="professional-mark-stage"><BrandMark id={mark.id} decorative /></div><h3>{mark.label}</h3><p>{mark.context}</p></li>)}</ul>
</section>

<style>
  .brand-showcase { background: var(--paper); }
  .brand-showcase-intro { align-items: end; }
  .organization-showcase { padding-top: 76px; }
  .organization-heading { display: flex; justify-content: space-between; align-items: end; gap: 30px; margin-bottom: 34px; }
  .organization-heading h3 { font-size: clamp(29px,3.5vw,52px); }
  .organization-heading p { font-size: 15px; color: var(--muted); }
  .organization-wall { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 14px; }
  .organization-mark { min-width: 0; padding: 22px 25px 20px; background: #fff; text-align: center; }
  .organization-mark-stage { height: 125px; display: grid; place-items: center; }
  .organization-mark :global(.brand-mark) { width: 100%; max-width: 188px; height: 70px; object-fit: contain; transition: transform 320ms var(--ease-out); }
  .organization-mark :global(.brand-mark--compact) { max-width: 100px; height: 90px; }
  .organization-mark > span { display: block; margin-top: 16px; font-size: 12px; line-height: 1.4; color: var(--muted); }
  .brand-credit-note { font-size: 14px; max-width: 680px; color: var(--muted); margin-top: 35px; }
  .team-showcase { background: var(--ink); color: var(--ground); --focus: white; }
  .team-showcase .section-intro p { color: #bac6d8; }
  .professional-marks { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 22px; }
  .professional-marks li { min-width: 0; }
  .professional-mark-stage { background: #fff; padding: 25px; min-height: 125px; display: grid; place-items: center; }
  .professional-mark-stage :global(.brand-mark) { width: 100%; max-width: 210px; height: 65px; object-fit: contain; transition: transform 320ms var(--ease-out); }
  .professional-marks h3 { font: 550 18px/1.3 var(--display); letter-spacing: -.025em; margin-top: 24px; }
  .professional-marks p { color: #bac6d8; font-size: 13px; margin-top: 9px; max-width: 230px; }
  @media (hover: hover) and (pointer: fine) {
    .organization-mark:hover :global(.brand-mark), .professional-marks li:hover :global(.brand-mark) { transform: translateY(-4px); }
  }
  @media (max-width: 1050px) {
    .organization-wall { grid-template-columns: repeat(3,minmax(0,1fr)); }.organization-mark { padding-inline: 20px; }.professional-marks { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 35px 24px; }.professional-mark-stage { min-height: 140px; }
  }
  @media (max-width: 650px) {
    .organization-showcase { padding-top: 55px; }.organization-heading { display: block; }.organization-heading p { margin-top: 24px; font-size: 14px; }.organization-wall { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; }.organization-mark { padding: 14px 17px 18px; }.organization-mark-stage { height: 100px; }.organization-mark :global(.brand-mark) { height: 54px; }.organization-mark :global(.brand-mark--compact) { height: 75px; max-width: 80px; }.organization-mark > span { font-size: 11px; margin-top: 10px; }
    .brand-credit-note { margin-top: 28px; font-size: 13px; }.professional-marks { gap: 30px 15px; }.professional-mark-stage { padding: 18px; min-height: 110px; }.professional-mark-stage :global(.brand-mark) { height: 60px; }.professional-marks h3 { font-size: 17px; margin-top: 20px; }.professional-marks p { font-size: 12px; }
  }
  @media (max-width: 360px) {
    .professional-mark-stage { padding: 15px; }.professional-marks h3 { font-size: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .organization-mark :global(.brand-mark), .professional-mark-stage :global(.brand-mark) { transition: none; transform: none !important; }
  }
  :global(body[data-motion='paused']) .organization-mark :global(.brand-mark), :global(body[data-motion='paused']) .professional-mark-stage :global(.brand-mark) { transform: none !important; }
</style>
