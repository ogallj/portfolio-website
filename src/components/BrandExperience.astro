---
import BrandMark from './BrandMark.astro';
import Arrow from './Arrow.astro';
import BrandFamilies from './BrandFamilies.astro';
import { logoAssets, organizationMarks, professionalMarks } from '../data/brand-logos';
const nameOf = (id: string) => logoAssets.find(mark => mark.id === id)!.name;
---
<section class="brand-experience" id="brand-experience" aria-labelledby="brand-experience-title">
  <header class="brand-experience-introduction frame">
    <h2 id="brand-experience-title">Brand<br />experience.</h2>
    <div><p class="brand-experience-lead">Different voices, different audiences. Experience across agency, in-house and independent creative work.</p><p class="brand-experience-credit">This includes work through agencies and employers, alongside independent projects. Individual contributions and project credits accompany the work as it is added.</p></div>
  </header>

  <BrandFamilies />

  <section class="organization-roster frame" id="organization-roster" aria-labelledby="organization-roster-title">
    <header class="organization-roster-heading"><h3 id="organization-roster-title">Across<br />organisations.</h3><p>A wider field of brand and project experience, across businesses, communities and institutions.</p></header>
    <ul class="organization-register" aria-label="Organisations in Joshua’s brand and project experience">
      {organizationMarks.map(id => <li><div class="organization-signature"><BrandMark id={id} decorative /></div><span>{nameOf(id)}</span></li>)}
    </ul>
    <p class="organization-roster-context">Experience includes agency and employer engagements, as well as independent work.</p>
  </section>
</section>

<section class="team-experience frame" id="team-experience" aria-labelledby="team-experience-title">
  <header class="team-experience-heading"><h2 id="team-experience-title">Teams &amp;<br />independent work.</h2><div><p>Engineering, agency creative work and digital marketing have each shaped my practice.</p><a href="/about/#experience">Explore my experience <Arrow diagonal={false} /></a></div></header>
  <ul class="team-register" aria-label="Professional and independent experience">
    {professionalMarks.map(mark => <li><div class="team-signature"><BrandMark id={mark.id} decorative /></div><h3>{mark.id === 'freelancer' ? 'Independent practice' : mark.label}</h3><p>{mark.id === 'freelancer' ? 'Independent work through Freelancer.com' : mark.context}</p></li>)}
  </ul>
</section>

<style>
  .brand-experience { --brand-ink:#262d2b;--brand-muted:#626c66;color:var(--brand-ink);background:#f5f6f3;scroll-margin-top:20px; }
  .brand-experience-introduction { display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:10%;align-items:end;padding-top:clamp(75px,9vw,140px);padding-bottom:clamp(55px,6.5vw,100px); }
  .brand-experience-introduction h2 { font:400 clamp(54px,6.5vw,100px)/1.02 var(--display);letter-spacing:-.06em; }
  .brand-experience-introduction > div { min-width:0;max-width:440px;padding-bottom:5px; }
  .brand-experience-lead { max-width:34ch;font-size:clamp(17px,1.5vw,22px);line-height:1.6;letter-spacing:-.015em; }
  .brand-experience-credit { max-width:49ch;margin-top:25px;color:var(--brand-muted);font-size:12px;line-height:1.8; }
  .organization-roster { padding-block:clamp(65px,8vw,120px);background:#fff;scroll-margin-top:20px; }
  .organization-roster-heading { display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);align-items:end;gap:10%;margin-bottom:clamp(50px,6vw,90px); }
  .organization-roster-heading h3 { font:400 clamp(36px,4.4vw,66px)/1.05 var(--display);letter-spacing:-.05em; }
  .organization-roster-heading p { max-width:34ch;color:var(--brand-muted);font-size:13px;line-height:1.8; }
  .organization-register { display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(45px,5vw,75px) clamp(30px,5vw,80px);margin:0;padding:0;list-style:none; }
  .organization-register > li { min-width:0;text-align:center; }
  .organization-signature { display:flex;align-items:center;justify-content:center;min-width:0;min-height:90px; }
  .organization-signature :global(.brand-mark) { display:block;width:100%;max-width:170px;height:68px;object-fit:contain;object-position:center; }
  .organization-signature :global(.brand-mark--compact) { max-width:76px;height:78px; }
  .organization-signature :global(.brand-mark--portrait) { max-width:70px;height:78px; }
  .organization-register > li > span { display:block;min-height:34px;max-width:24ch;margin:17px auto 0;color:var(--brand-muted);font-size:11px;line-height:1.55;text-wrap:balance; }
  .organization-roster-context { max-width:57ch;margin-top:55px;color:var(--brand-muted);font-size:11px;line-height:1.8; }
  .team-experience { color:#262d2b;background:#edf1eb;padding-block:clamp(65px,7vw,105px);scroll-margin-top:20px; }
  .team-experience-heading { display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:10%;align-items:end;margin-bottom:55px; }
  .team-experience-heading h2 { font:400 clamp(34px,4.2vw,62px)/1.07 var(--display);letter-spacing:-.05em; }
  .team-experience-heading > div { min-width:0;max-width:350px; }
  .team-experience-heading p { color:#626c66;font-size:13px;line-height:1.8; }
  .team-experience-heading a { display:inline-flex;align-items:center;gap:25px;min-height:44px;margin-top:17px;font-size:11px; }
  .team-experience-heading :global(.arrow-icon) { width:16px;height:16px; }
  .team-register { display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:35px;margin:0;padding:0;list-style:none; }
  .team-register > li { min-width:0; }
  .team-signature { display:flex;align-items:center;justify-content:flex-start;min-height:65px;margin-bottom:21px; }
  .team-signature :global(.brand-mark) { width:100%;max-width:145px;height:45px;object-fit:contain;object-position:left center; }
  .team-register h3 { font:500 15px/1.4 var(--body);letter-spacing:-.02em; }
  .team-register p { max-width:26ch;margin-top:8px;color:#626c66;font-size:11px;line-height:1.7; }
  @media (hover:hover) and (pointer:fine) { .team-experience-heading a:hover { text-decoration:underline;text-underline-offset:5px; } }
  @media (max-width:1000px) { .brand-experience-introduction,.organization-roster-heading,.team-experience-heading { gap:7%; }.organization-register { column-gap:35px; }.organization-signature :global(.brand-mark) { max-width:145px; }.team-register { gap:25px; }.team-register h3 { font-size:14px; } }
  @media (max-width:760px) {
    .brand-experience-introduction { grid-template-columns:minmax(0,1fr);gap:30px;padding-top:65px;padding-bottom:50px; }
    .brand-experience-introduction h2 { font-size:clamp(49px,9.8vw,72px); }
    .brand-experience-introduction > div { max-width:460px;padding-bottom:0; }
    .brand-experience-lead { max-width:36ch;font-size:17px; }
    .brand-experience-credit { margin-top:20px;font-size:11px; }
    .organization-roster { padding-block:55px; }
    .organization-roster-heading { grid-template-columns:minmax(0,1fr);gap:24px;margin-bottom:45px; }
    .organization-roster-heading h3 { font-size:clamp(37px,7.3vw,53px); }
    .organization-roster-heading p { max-width:40ch;font-size:12px; }
    .organization-register { grid-template-columns:repeat(2,minmax(0,1fr));gap:38px 35px; }
    .organization-signature { min-height:80px; }
    .organization-signature :global(.brand-mark) { max-width:155px;height:62px; }
    .organization-signature :global(.brand-mark--compact),.organization-signature :global(.brand-mark--portrait) { max-width:68px;height:72px; }
    .organization-register > li > span { margin-top:13px;font-size:11px; }
    .organization-roster-context { margin-top:40px; }
    .team-experience { padding-block:55px; }
    .team-experience-heading { grid-template-columns:minmax(0,1fr);gap:25px;margin-bottom:40px; }
    .team-experience-heading h2 { font-size:clamp(33px,6.8vw,49px); }
    .team-experience-heading > div { max-width:420px; }
    .team-experience-heading p { font-size:12px; }
    .team-register { grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 35px; }
    .team-signature { min-height:58px;margin-bottom:14px; }
    .team-signature :global(.brand-mark) { max-width:145px;height:42px; }
    .team-register h3 { font-size:14px; }
  }
  @media (max-width:380px) { .organization-register,.team-register { column-gap:26px; }.organization-signature :global(.brand-mark) { height:56px; }.team-signature :global(.brand-mark) { height:38px; }.team-register h3 { font-size:13px; } }
</style>
