---
import BrandMark from './BrandMark.astro';
import Arrow from './Arrow.astro';
import BrandFamilies from './BrandFamilies.astro';
import { logoAssets, organizationMarks, professionalMarks } from '../data/brand-logos';
const nameOf = (id: string) => logoAssets.find(mark => mark.id === id)!.name;
---
<section class="rf-brand-experience" id="brand-experience" aria-labelledby="brand-experience-title">
  <div class="rf-experience-introduction frame">
    <div data-enter><h2 id="brand-experience-title">Brand<br />experience.</h2><div class="rf-experience-spectrum" aria-hidden="true"><i></i><i></i><i></i><i></i></div></div>
    <div data-enter>
      <p>Different voices. Different audiences. Experience across agency, in-house and independent creative work.</p>
      <p class="rf-experience-credit">Experience includes work through agencies and employers. Individual contributions and project credits accompany the work as it is added.</p>
    </div>
  </div>

  <BrandFamilies />

  <section class="rf-organization-roster frame" aria-labelledby="organization-roster-title">
    <div class="rf-roster-heading" data-enter>
      <h3 id="organization-roster-title">Other<br />organisations.</h3>
      <p>A wider field of brand and project experience, across businesses, communities and institutions.</p>
    </div>
    <ul class="rf-organization-register" aria-label="Selected organisations in Joshua’s experience">
      {organizationMarks.map(id => <li><div class="rf-organization-signature"><BrandMark id={id} decorative /></div><span>{nameOf(id)}</span></li>)}
    </ul>
    <p class="rf-roster-context">Brand and project experience. The teams and independent work behind my practice appear below.</p>
  </section>
</section>

<section class="rf-team-experience frame" aria-labelledby="team-experience-title">
  <div class="rf-team-introduction" data-enter>
    <h2 id="team-experience-title">The teams.<br />The practice.</h2>
    <p>Engineering, digital agencies and independent work have each shaped how I approach a brief.</p>
    <a class="text-link" href="/about/#experience-title">Explore my experience <Arrow diagonal={false} /></a>
  </div>
  <ul class="rf-team-record" aria-label="Professional and independent experience">
    {professionalMarks.map(mark => <li><div class="rf-team-signature"><BrandMark id={mark.id} decorative /></div><div class="rf-team-copy"><h3>{mark.label}</h3><p>{mark.context}</p></div></li>)}
  </ul>
</section>

<style>
  .rf-brand-experience { background: var(--paper); color: var(--ink); scroll-margin-top: 100px; }
  .rf-experience-introduction { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .8fr); column-gap: clamp(60px, 11vw, 170px); align-items: end; padding-block: clamp(65px, 8vw, 115px) clamp(50px, 6vw, 85px); }
  .rf-experience-introduction { background: #e9eee8; }
  .rf-experience-spectrum { display: flex; gap: 3px; margin-top: 32px; width: 158px; height: 15px; transform: skewX(-10deg); box-shadow: 4px 5px 0 #b8c5c2; }
  .rf-experience-spectrum i { flex: 1; background: #02b5d0; }
  .rf-experience-spectrum i:nth-child(2) { background: #e53585; }
  .rf-experience-spectrum i:nth-child(3) { background: #efc838; }
  .rf-experience-spectrum i:nth-child(4) { background: #263241; }
  .rf-experience-introduction h2 { font: 450 clamp(45px, 6.4vw, 94px)/.98 var(--display); letter-spacing: -.06em; }
  .rf-experience-introduction > div > p:first-child { font-size: clamp(17px, 1.5vw, 22px); line-height: 1.5; letter-spacing: -.02em; max-width: 36ch; }
  .rf-experience-credit { color: var(--muted); font-size: 12px; line-height: 1.7; max-width: 48ch; margin-top: 25px; }
  .rf-organization-roster { padding-block: clamp(65px, 8vw, 120px); background: #e6e9e3; }
  .rf-roster-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .75fr); column-gap: 12%; align-items: end; margin-bottom: 58px; }
  .rf-roster-heading h3 { font: 450 clamp(34px, 4.4vw, 65px)/1.02 var(--display); letter-spacing: -.05em; }
  .rf-roster-heading p { color: var(--muted); max-width: 35ch; font-size: 15px; line-height: 1.7; }
  .rf-organization-register { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(32px, 4vw, 60px) clamp(27px, 4vw, 65px); padding: clamp(30px, 4vw, 60px); background: #fff; border-top: 5px solid #263241; box-shadow: 8px 9px 0 #bac6c8, 12px 14px 0 #354149; margin-right: 14px; }
  .rf-organization-register > li { min-width: 0; }
  .rf-organization-signature { display: flex; align-items: center; min-height: 80px; }
  .rf-organization-signature :global(.brand-mark) { width: 100%; max-width: 165px; height: 60px; object-fit: contain; object-position: left center; }
  .rf-organization-signature :global(.brand-mark--compact) { max-width: 76px; height: 75px; }
  .rf-organization-register > li > span { display: block; color: var(--muted); font-size: 11px; line-height: 1.5; max-width: 22ch; margin-top: 16px; }
  .rf-roster-context { color: var(--muted); font-size: 12px; line-height: 1.6; margin-top: 23px; max-width: 64ch; }
  .rf-team-experience { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.25fr); gap: clamp(55px, 9vw, 145px); padding-block: clamp(65px, 8vw, 115px); background: var(--ground); color: var(--ink); }
  .rf-team-introduction h2 { font: 450 clamp(37px, 4.3vw, 64px)/1.04 var(--display); letter-spacing: -.05em; }
  .rf-team-introduction > p { color: var(--muted); font-size: 15px; line-height: 1.7; max-width: 32ch; margin-top: 27px; }
  .rf-team-introduction > a { margin-top: 25px; font-size: 12px; gap: 22px; }
  .rf-team-record { padding: 28px; background: #fff; border-left: 3px solid #02b5d0; box-shadow: 7px 9px 0 #d1dcde; margin-right: 9px; }
  .rf-team-record > li { display: grid; grid-template-columns: minmax(110px, .65fr) minmax(0, 1fr); gap: 28px; align-items: center; padding-block: 25px; border-top: 1px solid var(--line); }
  .rf-team-record > li:first-child { padding-top: 0; border-top: 0; }
  .rf-team-signature { min-width: 0; min-height: 90px; padding: 17px; display: flex; align-items: center; justify-content: center; background: #fff; }
  .rf-team-signature :global(.brand-mark) { width: 100%; max-width: 145px; height: 50px; object-fit: contain; }
  .rf-team-copy { min-width: 0; }
  .rf-team-copy h3 { font: 500 clamp(19px, 1.8vw, 27px)/1.2 var(--display); letter-spacing: -.03em; }
  .rf-team-copy p { color: var(--muted); font-size: 12px; line-height: 1.6; margin-top: 12px; max-width: 29ch; }
  @media (max-width: 1000px) {
    .rf-experience-introduction { column-gap: 65px; grid-template-columns: 1fr 1fr; }
    .rf-team-experience { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 55px; }
    .rf-team-record > li { gap: 22px; }
    .rf-organization-register { gap: 35px; padding: 35px; }
  }
  @media (max-width: 700px) {
    .rf-experience-introduction { grid-template-columns: 1fr; gap: 29px; padding-block: 60px 50px; }
    .rf-experience-introduction h2 { font-size: 54px; }
    .rf-experience-introduction > div > p:first-child { font-size: 17px; max-width: 36ch; }
    .rf-experience-credit { font-size: 11px; margin-top: 20px; }
    .rf-organization-roster { padding-block: 55px; }
    .rf-roster-heading { grid-template-columns: 1fr; gap: 24px; margin-bottom: 32px; }
    .rf-roster-heading h3 { font-size: 41px; }
    .rf-roster-heading p { font-size: 13px; max-width: 38ch; }
    .rf-organization-register { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 25px; padding: 30px; }
    .rf-organization-signature { min-height: 60px; }
    .rf-organization-signature :global(.brand-mark) { height: 48px; }
    .rf-organization-signature :global(.brand-mark--compact) { max-width: 55px; height: 60px; }
    .rf-organization-register > li > span { font-size: 10px; margin-top: 12px; }
    .rf-roster-context { font-size: 11px; margin-top: 20px; }
    .rf-team-experience { grid-template-columns: 1fr; gap: 38px; padding-block: 60px; }
    .rf-team-introduction h2 { font-size: 39px; }
    .rf-team-introduction > p { margin-top: 23px; font-size: 14px; max-width: 38ch; }
    .rf-team-introduction > a { margin-top: 18px; }
    .rf-team-record > li { grid-template-columns: minmax(105px, .65fr) minmax(0, 1fr); gap: 25px; padding-block: 22px; }
    .rf-team-record { padding: 23px; }
    .rf-team-signature { min-height: 82px; padding: 18px; }
    .rf-team-copy h3 { font-size: 22px; }
  }
  @media (max-width: 450px) {
    .rf-team-record { padding: 20px 16px; }
    .rf-organization-register { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 25px; padding: 25px; }
    .rf-organization-register > li > span { font-size: 11px; }
    .rf-team-record > li { grid-template-columns: minmax(90px, .7fr) minmax(0, 1fr); gap: 21px; }
    .rf-team-signature { padding: 12px; }
    .rf-team-copy h3 { font-size: 19px; }
    .rf-team-copy p { font-size: 11px; margin-top: 9px; }
  }
</style>
