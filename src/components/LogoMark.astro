---
import { joPaths, joViewBox } from '../data/identity';
---
<svg class="jo-logo" viewBox={joViewBox} width="88" height="64" fill="currentColor" aria-hidden="true" focusable="false" data-jo-mark>{joPaths.map(d => <path d={d} />)}</svg>
<style>.jo-logo { display:block;width:100%;height:100%; }</style>
