---
import Arrow from './Arrow.astro';
import ArtworkViewer from './ArtworkViewer.astro';
import { creativeWork, featuredCreativeWork, creativeKindLabel, creativeCategories } from '../data/creative-work';
---
<section class="creative-gallery frame" id="creative-work" data-creative-gallery aria-labelledby="creative-work-title">
  <header class="work-introduction"><h2 id="creative-work-title">Work, in<br />full colour.</h2><div><p>{featuredCreativeWork.length} highlights from a collection of {creativeWork.length} campaign, identity and brand pieces.</p><div class="work-actions"><a class="work-browse-all" href="/creative-marketing/work/">Browse all {creativeWork.length} artworks <Arrow /></a><a class="work-brand-link" href="#brand-experience">Brand experience <Arrow diagonal={false} /></a></div></div></header>
  <nav class="work-category-doors" aria-label="Browse creative work by category">{creativeCategories.map(category => <a href={category.href}><span class="work-category-preview" aria-hidden="true"><img src={category.cover.sources[0].src} srcset={category.cover.sources.map(source => `${source.src} ${source.width}w`).join(', ')} sizes="72px" alt="" width={category.cover.width} height={category.cover.height} loading="lazy" decoding="async" /></span><span><strong>{category.label}</strong><small>{category.count} pieces</small></span><Arrow /></a>)}</nav>
  <div class="work-spreads">
    {featuredCreativeWork.map((piece, index) => <figure class:list={['work-piece', `work-piece--${index + 1}`]}>
      <a class="work-image-link" href={piece.sourceHref} data-artwork-open={piece.id} aria-label={'Open artwork: ' + piece.brand + ' — ' + piece.title}><img src={piece.src} srcset={piece.sources.map(source => `${source.src} ${source.width}w`).join(', ')} sizes={index < 4 ? '(max-width: 750px) calc(100vw - 44px), 50vw' : '(max-width: 750px) calc(100vw - 44px), 30vw'} width={piece.width} height={piece.height} alt={piece.alt} loading="lazy" decoding="async" /></a>
      <figcaption><div><h3>{piece.brand}</h3><p>{piece.title}</p></div><span>{creativeKindLabel[piece.kind]}</span></figcaption>
    </figure>)}
  </div>
  <div class="work-collection-close" data-work-collection><div><h3>There's more to see.</h3><p>Explore the complete collection of {creativeWork.length} artworks.</p></div><a class="work-browse-all" href="/creative-marketing/work/">Browse all {creativeWork.length} artworks <Arrow /></a></div>
  <ArtworkViewer />
</section>
<script>import { initCreativeGallery } from '../scripts/creative-gallery'; initCreativeGallery();</script>
<style>
  .creative-gallery { padding-top:clamp(65px,8vw,120px);padding-bottom:clamp(60px,7vw,105px);background:#fbfcf9;--ink:#26352d;--muted:#5b685e;--focus:#3b5c40;color:var(--ink);scroll-margin-top:15px; }
  .work-introduction { display:flex;align-items:end;justify-content:space-between;gap:55px;margin-bottom:70px; }
  .work-introduction h2 { font-size:clamp(45px,5.4vw,82px);font-weight:420;line-height:1.03;letter-spacing:-.04em; }
  .work-introduction > div { max-width:330px; }
  .work-introduction p { font-size:14px;line-height:1.85;color:var(--muted); }
  .work-spreads { display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:75px 5%;align-items:start; }
  .work-piece { min-width:0; }
  .work-piece--1 { grid-column:1 / span 5; }
  .work-piece--2 { grid-column:7 / span 6;margin-top:90px; }
  .work-piece--3 { grid-column:1 / span 7; }
  .work-piece--4 { grid-column:9 / span 4;margin-top:80px; }
  .work-piece--5 { grid-column:1 / span 4; }
  .work-piece--6 { grid-column:5 / span 4; }
  .work-piece--7 { grid-column:9 / span 4; }
  .work-image-link { display:block; }
  .work-image-link img { display:block;width:100%;height:auto; }
  .work-piece figcaption { display:flex;align-items:start;justify-content:space-between;gap:20px;margin-top:20px; }
  .work-piece h3 { font:550 13px/1.5 var(--body);letter-spacing:0; }
  .work-piece figcaption p { font-size:11px;color:var(--muted);line-height:1.7;margin-top:4px; }
  .work-piece figcaption > span { color:var(--muted);font-size:9px;line-height:1.8;text-align:right; }
  .work-actions { display:flex;flex-wrap:wrap;gap:12px 24px;align-items:center;margin-top:23px; }
  .work-browse-all { display:inline-flex;justify-content:center;align-items:center;gap:22px;min-height:50px;padding:13px 23px;border-radius:30px;background:#304c39;color:#fbfcf9;font-size:12px; }
  .work-browse-all :global(.arrow-icon) { width:16px;height:16px;transform:none; }
  .work-brand-link { display:inline-flex;align-items:center;gap:15px;min-height:44px;font-size:11px; }
  .work-brand-link :global(.arrow-icon) { width:15px;height:15px;transform:rotate(90deg); }
  .work-category-doors { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:35px;margin-bottom:70px; }
  .work-category-doors > a { display:grid;grid-template-columns:72px minmax(0,1fr) 18px;align-items:center;gap:18px;min-height:112px;padding:18px 0;border-top:1px solid #cbd4c8;border-bottom:1px solid #cbd4c8; }
  .work-category-preview { display:flex;align-items:center;justify-content:center;height:80px; }
  .work-category-preview img { display:block;width:100%;height:auto;max-height:80px;object-fit:contain; }
  .work-category-doors strong { display:block;font-size:13px;font-weight:550;line-height:1.5; }
  .work-category-doors small { display:block;font-size:10px;color:var(--muted);margin-top:8px; }
  .work-category-doors :global(.arrow-icon) { width:18px;height:18px; }
  .work-collection-close { display:flex;align-items:center;justify-content:space-between;gap:30px;margin-top:80px;padding-top:35px;border-top:1px solid #cbd4c8; }
  .work-collection-close h3 { font:430 clamp(27px,3vw,42px)/1.2 var(--display);letter-spacing:-.025em; }
  .work-collection-close p { font-size:12px;line-height:1.8;color:var(--muted);margin-top:12px; }
  @media(hover:hover) and (pointer:fine) { .work-category-doors a:hover strong,.work-brand-link:hover { text-decoration:underline;text-underline-offset:5px; }.work-browse-all:hover { background:#243d2c; } }
  @media(max-width:1050px) { .work-category-doors { gap:22px; }.work-category-doors > a { grid-template-columns:55px minmax(0,1fr) 16px;gap:13px; }.work-category-doors strong { font-size:12px; } }
  @media(max-width:750px) { .work-introduction { display:block;margin-bottom:35px; }.work-introduction > div { max-width:450px;margin-top:26px; }.work-introduction p { font-size:13px; }.work-introduction h2 { font-size:clamp(44px,10vw,66px); }.work-category-doors { grid-template-columns:minmax(0,1fr);gap:0;margin-bottom:45px; }.work-category-doors > a { grid-template-columns:56px minmax(0,1fr) 18px;min-height:90px;padding-block:12px;border-bottom:0; }.work-category-doors > a:last-child { border-bottom:1px solid #cbd4c8; }.work-category-preview { height:65px; }.work-category-preview img { max-height:65px; }.work-spreads { display:block; }.work-piece { margin:0 0 40px; }.work-piece figcaption { gap:15px;margin-top:16px; }.work-piece h3 { font-size:12px; }.work-piece figcaption p { font-size:10px; }.work-piece figcaption > span { font-size:8px; }.work-collection-close { align-items:start;flex-direction:column;gap:22px;margin-top:25px;padding-top:28px; } }
</style>
