---
import SystemExhibition from './SystemExhibition.astro';
import WebsiteExhibition from './WebsiteExhibition.astro';
import { projects } from '../data/portfolio';
const systems = projects.filter(project => project.kind === 'system');
const websites = projects.filter(project => project.kind === 'website');
---
<section class="software-collection" id="software-collection" aria-labelledby="software-collection-title" data-project-collection tabindex="-1">
  <div class="software-collection-heading frame"><h2 id="software-collection-title">The work.</h2><div class="software-filters" role="group" aria-label="Filter software projects"><button type="button" data-filter="all" aria-pressed="true">All <span>{projects.length}</span></button><button type="button" data-filter="system" aria-pressed="false">Systems <span>{systems.length}</span></button><button type="button" data-filter="website" aria-pressed="false">Websites <span>{websites.length}</span></button></div></div>
  <p class="sr-only" role="status" data-filter-status>{projects.length} projects shown</p>
  <SystemExhibition />
  <section class="software-website-collection" data-project-group="website" aria-labelledby="websites-title" id="websites"><WebsiteExhibition /></section>
</section>
<style>
  .software-collection { scroll-margin-top:110px; }
  .software-collection-heading { display:flex;justify-content:space-between;align-items:center;gap:35px;padding-bottom:55px; }
  .software-collection-heading h2 { font:420 clamp(42px,4.5vw,68px)/1.05 var(--display);letter-spacing:-.055em; }
  .software-filters { display:flex;gap:3px;padding:4px;border:1px solid #c8cfc3;border-radius:40px; }
  .software-filters button { display:inline-flex;justify-content:center;align-items:center;gap:9px;min-height:44px;min-width:83px;border:0;border-radius:30px;padding:10px 17px;background:transparent;color:var(--muted);font-size:11px;transition:background 180ms ease,color 180ms ease; }
  .software-filters button[aria-pressed='true'] { background:#242824;color:#f8faf5; }
  .software-filters span { font-size:9px;opacity:.8; }
  @media(hover:hover) and (pointer:fine) { .software-filters button:not([aria-pressed='true']):hover { background:#e1e6dd;color:#242824; } }
  @media(max-width:700px) { .software-collection-heading { display:block;padding-bottom:35px; }.software-collection-heading h2 { font-size:49px; }.software-filters { display:inline-flex;margin-top:24px; }.software-filters button { min-width:75px;padding-inline:14px;font-size:10px;gap:7px; } }
</style>
