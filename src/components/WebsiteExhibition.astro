---
import Arrow from './Arrow.astro';
import WebsiteCover from './WebsiteCover.astro';
import { projects } from '../data/portfolio';
import { websiteAssets, websiteMediaLabel } from '../data/website-media';
const websites = projects.filter(project => project.kind === 'website');
const domainOf = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---
<div class="website-exhibition frame" data-web-exhibition>
  <header class="website-exhibition-heading"><h2 id="websites-title">Websites with<br />a point of view.</h2><p>Spaces for communities, organisations and independent businesses. A collection of {websites.length} websites, shaped through frontend development and UI/UX.</p></header>
  <div class="website-browse-bar">
    <p class="website-collection-label">The website collection</p>
    <div class="website-controls" data-web-controls hidden><span data-web-position>1 / {websites.length}</span><div><button type="button" data-web-previous aria-label="Previous website"><Arrow diagonal={false} /></button><button type="button" data-web-next aria-label="Next website"><Arrow diagonal={false} /></button></div></div>
    <details class="website-index" data-web-directory>
      <summary><span>All websites <span class="website-directory-count">{websites.length}</span></span><span class="website-directory-symbol" aria-hidden="true"><i></i><i></i></span></summary>
      <nav class="website-directory" aria-label="Choose a website to preview"><p>Choose a project to explore.</p><ol>{websites.map((project,index) => <li><a href={'#web-' + project.slug} data-web-select={project.slug} aria-current={index === 0 ? 'true' : undefined} aria-controls={'web-' + project.slug}><span class="website-directory-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><span><span class="website-directory-name">{project.title}</span><span class="website-directory-category">{project.category}</span></span><Arrow /></a></li>)}</ol></nav>
    </details>
  </div>
  <div class="website-stage" data-web-stage>
    {websites.map(project => {
      const asset = websiteAssets[project.website!];
      return <article class="website-panel" id={'web-' + project.slug} data-web-panel={project.slug} data-kind="website" data-active={project === websites[0] ? 'true' : undefined} aria-labelledby={'web-' + project.slug + '-title'} tabindex="-1">
        <div class="website-project-meta" data-web-meta><p class="website-project-category">{project.category}</p><h3 id={'web-' + project.slug + '-title'}>{project.title}</h3></div>
        <div class="website-project-actions">{asset.liveStatus !== 'unavailable' ? <a class="website-visit" href={project.liveUrl} target="_blank" rel="noreferrer">Visit website <Arrow /></a> : <span class="website-unavailable">Live site unavailable</span>}<a class="website-overview" href={'/software/' + project.slug + '/'}>Project overview <Arrow /></a></div>
        <div class="website-artboard"><div class="website-media-motion" data-web-media-motion><div class="website-poster"><WebsiteCover project={project} sizes="(max-width: 700px) calc(100vw - 44px), (max-width: 1200px) 90vw, 1120px" /></div><div class="website-live-viewport" data-web-live-viewport hidden><iframe data-web-frame data-live-src={project.liveUrl} title={project.title + ' live website preview'} sandbox="allow-scripts allow-same-origin" referrerpolicy="no-referrer" tabindex="-1" loading="lazy"></iframe></div></div></div>
        <div class="website-image-caption"><span data-web-media-label={websiteMediaLabel(asset.kind, asset.archived)}>{websiteMediaLabel(asset.kind, asset.archived)}</span><span class="website-capture-access"><span>{domainOf(project.liveUrl!)}</span><a href={asset.src} target="_blank" rel="noreferrer" aria-label={'View full homepage capture of ' + project.title}>View full capture <Arrow /></a></span></div>
        <div class="website-project-description"><p class="website-project-summary">{project.summary}</p><div>{asset.embedAllowed && <button type="button" data-web-live aria-pressed="false" hidden>Preview live site</button>}<p class="website-live-note" data-web-live-note role="status"></p></div></div>
      </article>;
    })}
    <p class="sr-only" data-web-announcement role="status" aria-atomic="true"></p>
  </div>
  <div class="website-exhibition-close"><p>Different audiences.<br />The same care in the details.</p><a href="/software/?view=system#systems">Explore business systems <Arrow diagonal={false} /></a></div>
</div>
<script>import { initWebsiteExhibitions } from '../scripts/websites'; initWebsiteExhibitions();</script>
<style>
  .website-exhibition { --website-text:#242824;--website-muted:#616760;--focus:#304c3c;position:relative;padding-block:clamp(80px,9vw,145px) clamp(65px,8vw,120px);background:#e7ebe5;color:var(--website-text); }
  .website-exhibition-heading { display:grid;grid-template-columns:minmax(0,1.8fr) minmax(0,1fr);align-items:end;gap:8%;margin-bottom:70px; }
  .website-exhibition-heading h2 { font:400 clamp(55px,6.7vw,104px)/1.04 var(--display);letter-spacing:-.06em; }
  .website-exhibition-heading p { max-width:340px;font-size:13px;line-height:1.8;color:var(--website-muted);padding-bottom:5px; }
  .website-browse-bar { position:relative;display:flex;align-items:center;gap:35px;padding-block:22px;margin-bottom:45px;border-top:1px solid #bdc6b8;border-bottom:1px solid #bdc6b8;z-index:3; }
  .website-collection-label { font-size:11px;margin-right:auto;color:var(--website-muted); }
  .website-controls { display:flex;align-items:center;gap:22px; }
  .website-controls > span { min-width:44px;text-align:center;font-size:11px;font-variant-numeric:tabular-nums; }
  .website-controls > div { display:flex;gap:7px; }
  .website-controls button { display:grid;place-items:center;width:44px;height:44px;border:1px solid #bac4b6;border-radius:50%;padding:0;color:var(--website-text);background:transparent;transition:background 180ms ease,border-color 180ms ease; }
  .website-controls button :global(.arrow-icon) { width:17px;height:17px; }
  .website-controls button:first-child :global(.arrow-icon) { transform:rotate(180deg); }
  .website-index { margin:0; }
  .website-index summary { display:flex;align-items:center;justify-content:space-between;gap:40px;min-height:46px;padding:10px 18px;border:1px solid #aab6a5;border-radius:30px;font-size:11px;list-style:none; }
  .website-index summary::-webkit-details-marker { display:none; }
  .website-directory-count { color:var(--website-muted);margin-left:7px;font-size:9px; }
  .website-directory-symbol { position:relative;display:block;width:13px;height:13px;transition:transform 180ms var(--ease-out); }
  .website-directory-symbol i { position:absolute;top:6px;left:0;width:13px;height:1px;background:currentColor; }
  .website-directory-symbol i:last-child { transform:rotate(90deg); }
  .website-index[open] .website-directory-symbol { transform:rotate(45deg); }
  .website-index[open] summary { background:#f7f8f5; }
  .website-directory { position:absolute;right:0;top:calc(100% + 10px);width:min(100%,850px);padding:30px;background:#f8f9f6;border:1px solid #c9d1c5;border-radius:16px;box-shadow:0 18px 45px #17212812;max-height:min(66svh,650px);overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:#a5b29e transparent; }
  .website-index[data-directory-above] .website-directory { top:auto;bottom:calc(100% + 10px); }
  .website-directory > p { font-size:11px;color:var(--website-muted);padding-bottom:22px; }
  .website-directory ol { display:grid;grid-template-columns:1fr 1fr;gap:0 40px;list-style:none;margin:0;padding:0; }
  .website-directory a { display:grid;grid-template-columns:25px minmax(0,1fr) 16px;gap:11px;align-items:center;min-height:76px;padding:15px 3px;border-top:1px solid #d5dbd0; }
  .website-directory-number { align-self:start;padding-top:3px;font-size:9px;color:#6d7768;font-variant-numeric:tabular-nums; }
  .website-directory-name { display:block;font-size:13px;font-weight:550;line-height:1.4; }
  .website-directory-category { display:block;font-size:10px;line-height:1.5;margin-top:5px;color:var(--website-muted); }
  .website-directory :global(.arrow-icon) { width:15px;height:15px;opacity:0; }
  .website-directory a[aria-current] :global(.arrow-icon) { opacity:1; }
  .website-directory a[aria-current] .website-directory-name { text-decoration:underline;text-underline-offset:4px; }
  .website-stage { min-width:0; }
  .website-panel { display:grid;grid-template-columns:1fr 1fr;gap:0 8%;max-width:1120px;margin-inline:auto;min-width:0;scroll-margin-top:115px; }
  .website-panel + .website-panel { margin-top:100px; }
  .website-project-meta { min-width:0;align-self:end; }
  .website-project-category { font-size:10px;color:var(--website-muted);margin-bottom:12px; }
  .website-project-meta h3 { font:420 clamp(29px,3.1vw,48px)/1.1 var(--display);letter-spacing:-.05em;overflow-wrap:anywhere; }
  .website-project-actions { display:flex;justify-content:end;align-items:end;flex-wrap:wrap;gap:12px 25px;padding-bottom:3px; }
  .website-project-actions a { display:inline-flex;align-items:center;justify-content:space-between;gap:25px;min-height:46px;font-size:11px; }
  .website-project-actions :global(.arrow-icon) { width:15px;height:15px; }
  .website-visit { padding:12px 19px;background:#242824;color:#f6f8f3;border-radius:28px; }
  .website-overview { color:#4e5949; }
  .website-unavailable { font-size:12px;color:var(--website-muted); }
  .website-artboard { grid-column:1/-1;min-width:0;margin-top:32px; }
  .website-media-motion { min-width:0;border-radius:8px;overflow:hidden;background:#f8faf7; }
  .website-live-viewport { position:relative;aspect-ratio:4/3;overflow:hidden;background:#fff; }
  .website-live-viewport iframe { display:block;width:1440px;height:1080px;border:0;transform-origin:top left;pointer-events:none; }
  .website-image-caption { grid-column:1/-1;display:flex;justify-content:space-between;gap:20px;padding-block:17px 23px;color:var(--website-muted);font-size:10px;line-height:1.6;border-bottom:1px solid #bec8b9; }
  .website-image-caption > span:last-child { text-align:right;overflow-wrap:anywhere; }
  .website-capture-access { display:flex;align-items:center;justify-content:end;gap:28px; }
  .website-capture-access > a { display:inline-flex;align-items:center;gap:12px;min-height:44px;color:var(--website-text);white-space:nowrap; }
  .website-capture-access :global(.arrow-icon) { width:13px;height:13px; }
  .website-project-description { grid-column:1/-1;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8%;padding-top:24px; }
  .website-project-summary { max-width:490px;font-size:13px;line-height:1.8;color:#505b4b; }
  .website-project-description > div { text-align:right; }
  .website-project-description button { padding:0;min-height:44px;border:0;background:none;font-size:11px;color:var(--website-text);text-decoration:underline;text-underline-offset:5px; }
  .website-live-note { margin-top:8px;max-width:390px;margin-left:auto;font-size:11px;line-height:1.7;color:var(--website-muted); }
  .website-live-note:empty { display:none; }
  .website-exhibition-close { display:flex;justify-content:space-between;gap:35px;align-items:end;margin-top:75px; }
  .website-exhibition-close > p { color:var(--website-muted);font-size:12px;line-height:1.65; }
  .website-exhibition-close a { display:inline-flex;align-items:center;gap:35px;min-height:44px;font-size:12px; }
  .website-exhibition-close :global(.arrow-icon) { width:18px;height:18px; }
  .website-exhibition[data-enhanced] .website-panel:not([data-active]) { display:none; }
  .website-exhibition[data-enhanced] .website-panel + .website-panel { margin-top:0; }
  @media(hover:hover) and (pointer:fine) { .website-controls button:hover { background:#f8f9f6;border-color:#8d9d86; }.website-directory a:hover .website-directory-name,.website-overview:hover,.website-exhibition-close a:hover { text-decoration:underline;text-underline-offset:5px; }.website-visit:hover { background:#3c4937; } }
  @media(max-width:1000px) { .website-exhibition-heading { gap:6%;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr); }.website-exhibition-heading h2 { font-size:6.8vw; }.website-project-actions { flex-direction:column;align-items:end;gap:3px; }.website-project-description { gap:6%; } }
  @media(max-width:700px) {
    .website-exhibition { padding-block:65px; }
    .website-exhibition-heading { grid-template-columns:1fr;gap:25px;margin-bottom:35px; }
    .website-exhibition-heading h2 { font-size:clamp(43px,8.5vw,60px); }
    .website-exhibition-heading p { font-size:12px;max-width:360px; }
    .website-browse-bar { flex-wrap:wrap;gap:15px;padding-block:17px;margin-bottom:30px; }
    .website-collection-label { flex:1 1 100%;font-size:10px; }
    .website-controls { margin-right:auto;gap:9px; }
    .website-controls > div { gap:5px; }
    .website-controls > span { font-size:10px;min-width:37px; }
    .website-index summary { gap:17px;padding-inline:15px;font-size:10px; }
    .website-directory-count { margin-left:5px; }
    .website-directory { width:100%;padding:23px 18px;border-radius:10px;max-height:60svh; }
    .website-directory ol { grid-template-columns:1fr; }
    .website-directory a { min-height:69px; }
    .website-directory-name { font-size:12px; }
    .website-project-meta h3 { font-size:clamp(27px,6vw,40px); }
    .website-panel { grid-template-columns:1fr; }
    .website-project-actions { flex-direction:row;justify-content:start;align-items:center;gap:9px 23px;margin-top:20px;padding-bottom:0; }
    .website-project-actions a { font-size:10px;gap:20px; }
    .website-visit { padding:11px 16px; }
    .website-artboard { margin-top:24px; }
    .website-media-motion { border-radius:5px; }
    .website-image-caption { padding-block:13px 18px;font-size:9px;gap:20px; }
    .website-capture-access { flex-direction:column;align-items:end;gap:0; }
    .website-project-description { grid-template-columns:1fr;gap:14px;padding-top:19px; }
    .website-project-summary { font-size:12px; }
    .website-project-description > div { text-align:left; }
    .website-live-note { margin-left:0; }
    .website-exhibition-close { margin-top:45px;display:block; }
    .website-exhibition-close > p { font-size:11px; }
    .website-exhibition-close a { margin-top:20px;font-size:11px; }
  }
  @media(max-width:360px) { .website-index summary { gap:12px;padding-inline:11px; }.website-controls { gap:3px; }.website-controls > div { gap:4px; }.website-controls button { width:44px; }.website-browse-bar { gap:15px 5px; } }
</style>
