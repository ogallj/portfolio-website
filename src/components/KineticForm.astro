---
interface Props { variant?: 'blue' | 'warm' }
const { variant = 'blue' } = Astro.props;
---
<div class:list={['kinetic-form', `kinetic-form--${variant}`]} data-kinetic aria-hidden="true">
  <div class="kinetic-pointer" data-motion-pointer>
    <div class="kinetic-float">
      <div class="kinetic-rotor" data-kinetic-rotor>
        {Array.from({ length: 12 }, (_, index) => <span class="kinetic-blade" style={`--blade-angle:${index * 30}deg`}></span>)}
        <span class="kinetic-core"></span>
        <span class="kinetic-orbit kinetic-orbit--one"></span>
        <span class="kinetic-orbit kinetic-orbit--two"></span>
      </div>
    </div>
  </div>
</div>

<style>
  .kinetic-form { --metal-light: #eff5ff; --metal: #6082dd; --metal-dark: #1635b9; --orbit: #1746ff55; width: 100%; aspect-ratio: 1; position: relative; perspective: 1000px; pointer-events: none; }
  .kinetic-form--warm { --metal-light: #fff0d5; --metal: #b43c2f; --metal-dark: #662d41; --orbit: #792c3b66; }
  .kinetic-pointer,.kinetic-float,.kinetic-rotor { position: absolute; inset: 0; transform-style: preserve-3d; }
  .kinetic-rotor { transform: rotateX(24deg) rotateY(-28deg) rotateZ(-22deg); }
  .kinetic-blade { position: absolute; left: 50%; top: 43%; width: 41%; height: 14%; transform-origin: 0 50%; transform: rotateZ(var(--blade-angle)) translateX(9%) rotateY(-32deg); border: 1px solid #ffffff50; border-radius: 7% 50% 12% 30%; background: linear-gradient(165deg,var(--metal-light),var(--metal) 38%,var(--metal-dark) 78%); box-shadow: 0 5px 9px #13203518; backface-visibility: visible; }
  .kinetic-core { position: absolute; inset: 43%; border-radius: 50%; transform: translateZ(25px); background: radial-gradient(circle at 32% 25%,var(--metal-light),var(--metal) 45%,var(--metal-dark)); box-shadow: 0 10px 18px #13203530; }
  .kinetic-orbit { position: absolute; inset: 6%; border: 1px solid var(--orbit); border-radius: 50%; }
  .kinetic-orbit--one { transform: rotateX(72deg) translateZ(-20px); }
  .kinetic-orbit--two { inset: 0; transform: rotateY(65deg) rotateZ(35deg); }
  :global(body[data-motion='playing']) .kinetic-form[data-in-view] .kinetic-float { animation: kinetic-drift 12s ease-in-out infinite alternate; }
  @keyframes kinetic-drift { from { transform: translateY(-7px) rotateZ(-4deg); } to { transform: translateY(7px) rotateZ(4deg); } }
  @media (max-width: 600px) { .kinetic-form { perspective: 800px; }.kinetic-blade { box-shadow: none; } }
  @media (prefers-reduced-motion: reduce) { .kinetic-float { animation: none !important; } }
</style>
