---
import Arrow from './Arrow.astro';
import LogoMark from './LogoMark.astro';
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
const path = Astro.url.pathname;
const links = [ ['/software/', 'Software'], ['/creative-marketing/', 'Creative & marketing'], ['/about/', 'About'], ['/cv/', 'CVs'] ];
---
<header class:list={['site-header', { 'site-header--dark': dark }]}>
  <div class="header-shell">
    <a class="wordmark" href="/" aria-label="Joshua Ogallo — home" aria-current={path === '/' ? 'page' : undefined}><span class="wordmark-symbol" aria-hidden="true"><LogoMark /></span><span class="wordmark-name">Joshua Ogallo<span>Engineer &amp; creative</span></span></a>
    <nav class="desktop-nav" aria-label="Main navigation">{links.map(([href, title]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{title}</a>)}</nav>
    <a href="/contact/" class="header-contact" aria-current={path === '/contact/' ? 'page' : undefined}>Contact <Arrow /></a>
    <details class="mobile-menu">
      <summary>Menu <span class="menu-cross" aria-hidden="true"><i></i><i></i></span></summary>
      <nav aria-label="Mobile navigation"><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>{links.map(([href, title]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{title}</a>)}<a class="mobile-contact" href="/contact/" aria-current={path === '/contact/' ? 'page' : undefined}>Contact <Arrow /></a></nav>
    </details>
  </div>
</header>
<style>
  .site-header { --header-ground:#f8faf9;--header-ink:#242d29;--header-muted:#66716a;--header-surface:#f8faf7;--header-line:#cbd3ca;--header-active:#e6ece3;--header-action:#242d29;--header-action-ink:#f8faf7;--focus:#304f3b;position:fixed;top:0;left:0;right:0;z-index:100;height:88px;padding:13px var(--gutter);color:var(--header-ink);background:var(--header-ground); }
  .site-header--dark { --header-ground:#101820;--header-ink:#edf3f3;--header-muted:#b1c0c9;--header-surface:#17232c;--header-line:#43535e;--header-active:#2c3d48;--header-action:#edf3f3;--header-action-ink:#14212a;--focus:#bfd2ff; }
  .header-shell { position:relative;display:flex;align-items:center;gap:22px;width:100%;max-width:1600px;height:62px;margin-inline:auto;padding:7px 8px 7px 20px;border:1px solid var(--header-line);border-radius:40px;background:var(--header-surface);box-shadow:0 4px 18px #17212805; }
  .wordmark { display:inline-flex;align-items:center;gap:15px;min-width:0;min-height:44px;margin-right:auto;color:var(--header-ink); }
  .wordmark-symbol { display:block;flex:0 0 auto;width:48px;height:35px; }
  .wordmark-name { display:block;font-size:11px;font-weight:650;line-height:1.4;white-space:nowrap; }
  .wordmark-name > span { display:block;margin-top:3px;color:var(--header-muted);font-size:9px;font-weight:400; }
  .desktop-nav { display:flex;align-items:center;gap:3px; }
  .desktop-nav a { position:relative;display:inline-flex;align-items:center;justify-content:center;min-height:44px;min-width:44px;padding:10px 13px 10px 24px;border-radius:28px;color:var(--header-muted);font-size:11px;font-weight:550;white-space:nowrap;transition:background 180ms ease,color 180ms ease; }
  .desktop-nav a::before { content:'';position:absolute;left:12px;top:calc(50% - 2px);width:4px;height:4px;border-radius:50%;background:currentColor;opacity:0; }
  .desktop-nav a[aria-current] { color:var(--header-ink);background:var(--header-active); }
  .desktop-nav a[aria-current]::before { opacity:1; }
  .header-contact { display:inline-flex;flex:0 0 auto;align-items:center;justify-content:center;gap:22px;min-height:44px;padding:11px 19px;border-radius:30px;background:var(--header-action);color:var(--header-action-ink);font-size:11px;font-weight:600; }
  .header-contact :global(.arrow-icon) { width:15px;height:15px;transition:transform 180ms var(--ease-out); }
  .mobile-menu { display:none; }
  @media (hover:hover) and (pointer:fine) { .desktop-nav a:hover { color:var(--header-ink);background:var(--header-active); }.header-contact:hover :global(.arrow-icon) { transform:translate(2px,-2px); } }
  @media (max-width:1150px) and (min-width:1041px) { .header-shell { gap:12px;padding-left:17px; }.wordmark { gap:11px; }.desktop-nav a { padding-right:10px;padding-left:21px; }.desktop-nav a::before { left:10px; }.header-contact { gap:15px;padding-inline:16px; } }
  @media (max-width:1040px) {
    .site-header { height:78px;padding-block:10px; }
    .header-shell { height:58px;padding:6px 7px 6px 17px;gap:15px; }
    .desktop-nav,.header-contact { display:none; }
    .mobile-menu { display:block;flex:0 0 auto; }
    .mobile-menu summary { display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:44px;padding:10px 14px;border-radius:28px;background:var(--header-active);color:var(--header-ink);font-size:11px;list-style:none; }
    .mobile-menu summary::-webkit-details-marker { display:none; }
    .menu-cross { position:relative;display:block;width:13px;height:13px;transition:transform 180ms var(--ease-out); }
    .menu-cross i { position:absolute;top:6px;left:0;width:13px;height:1px;background:currentColor; }
    .menu-cross i:last-child { transform:rotate(90deg); }
    .mobile-menu[open] .menu-cross { transform:rotate(45deg); }
    .mobile-menu nav { position:fixed;top:78px;left:var(--gutter);right:var(--gutter);display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:6px 16px;max-height:calc(100svh - 78px - 16px);overflow-y:auto;overscroll-behavior:contain;padding:18px;border:1px solid var(--header-line);border-radius:20px;background:var(--header-surface);color:var(--header-ink);box-shadow:0 16px 35px #08131c12; }
    .mobile-menu:not([open]) nav { display:none; }
    .mobile-menu nav a { display:flex;align-items:center;justify-content:space-between;gap:15px;min-height:58px;padding:12px 15px;border-radius:10px;font:420 clamp(19px,2.7vw,28px)/1.2 var(--display);letter-spacing:-.025em; }
    .mobile-menu nav a[aria-current] { background:var(--header-active); }
    .mobile-menu nav .mobile-contact { background:var(--header-action);color:var(--header-action-ink); }
    .mobile-contact :global(.arrow-icon) { width:20px;height:20px; }
  }
  @media (max-width:500px) { .header-shell { padding-left:14px;gap:10px; }.wordmark { gap:11px; }.wordmark-symbol { width:44px;height:32px; }.wordmark-name { font-size:10px; }.wordmark-name > span { font-size:8px; }.mobile-menu summary { gap:14px;padding-inline:13px;font-size:10px; }.mobile-menu nav { grid-template-columns:minmax(0,1fr);gap:2px;padding:13px; }.mobile-menu nav a { min-height:51px;font-size:22px; } }
  @media (prefers-reduced-motion:reduce) { .header-contact :global(.arrow-icon) { transition:none;transform:none !important; }.menu-cross { transition:none; } }
  :global(html[data-motion='paused']) .header-contact :global(.arrow-icon) { transition:none;transform:none !important; }
  :global(html[data-motion='paused']) .menu-cross { transition:none; }
</style>
