---
import Arrow from './Arrow.astro';
const path = Astro.url.pathname;
const links = [ ['/software/', 'Software'], ['/creative-marketing/', 'Creative & marketing'], ['/about/', 'About'] ];
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label="Joshua Ogallo — home"><span class="wordmark-symbol" aria-hidden="true">jo.</span><span>Joshua Ogallo</span></a>
  <nav class="desktop-nav" aria-label="Main navigation">
    {links.map(([href, title]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{title}</a>)}
  </nav>
  <a href="/contact/" class="header-contact" aria-current={path === '/contact/' ? 'page' : undefined}>Let’s talk <Arrow /></a>
  <details class="mobile-menu">
    <summary>Menu <span aria-hidden="true">+</span></summary>
    <nav aria-label="Mobile navigation">
      <a href="/">Home</a>
      {links.map(([href, title]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{title}</a>)}
      <a href="/contact/">Contact</a>
      <a href="/joshua-ogallo-cv.pdf" download>Download CV</a>
    </nav>
  </details>
</header>
