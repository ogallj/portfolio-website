---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import BrandMark from '../../components/BrandMark.astro';
import BrandExperience from '../../components/BrandExperience.astro';
import { creativeServices } from '../../data/portfolio';
import { creativeResume } from '../../data/resumes';
const tools = ['Photoshop', 'Illustrator', 'InDesign', 'Affinity'];
---
<Base title="Digital creative & marketing" theme="creative" footerVariant="compact" description="Creative ideas, visual communication and brand content by Joshua Ogallo. Explore his creative and marketing practice, brand experience and professional background.">
  <div class="creative-page" data-creative-page>
    <section class="creative-opening frame" data-creative-opening aria-labelledby="creative-title">
      <div class="creative-backdrop" data-creative-backdrop aria-hidden="true"><img src="/images/creative/hero-poster.webp" alt="" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" /><video data-creative-video muted loop playsinline preload="none" poster="/images/creative/hero-poster.webp" tabindex="-1"><source src="/videos/creative-waves.mp4" type="video/mp4" /></video></div>
      <div class="creative-opening-meta"><p>Creative &amp; marketing</p><p>Joshua Ogallo<span>Digital creative &amp; marketer</span></p></div>
      <h1 id="creative-title"><span class="creative-title-line"><span>Good ideas.</span></span><span class="creative-title-line"><span>Made visible.</span></span></h1>
      <div class="creative-opening-bottom"><p>I connect campaign ideas with visual craft, bringing a clear voice to brand content and digital communication.</p><div><a class="creative-explore" href="#brand-experience">Explore brand experience <span aria-hidden="true">↓</span></a><a class="creative-download" href={creativeResume.pdf} download={creativeResume.pdfFilename}>Download creative CV <Arrow /></a></div></div>
    </section>
    <section class="creative-contribution frame" aria-labelledby="fanta-contribution-title">
      <div class="creative-fanta-mark"><BrandMark id="fanta" decorative /><p>Fanta / Brand experience</p></div>
      <div class="creative-contribution-title"><p>Recent contribution</p><h2 id="fanta-contribution-title">Skizia Utamu<br />Challenge.</h2></div>
      <div class="creative-contribution-copy"><h3>Creative work &amp; ideation.</h3><p>Original campaign material will be added with the work, its context and individual credits.</p><a href="#coca-family-title">Explore the brand family <Arrow diagonal={false} /></a></div>
    </section>
    <BrandExperience />
    <section class="creative-practice frame" aria-labelledby="creative-capabilities-title">
      <header><h2 id="creative-capabilities-title">From the first idea<br />to the final detail.</h2><p>Ideas and visual craft for digital communication, brand content and marketing projects.</p></header>
      <div class="creative-services">{creativeServices.map(service => <article><h3>{service.title}</h3><p>{service.description}</p></article>)}</div>
      <div class="creative-tools"><p>Tools I work with</p><ul aria-label="Creative software">{tools.map(tool => <li>{tool}</li>)}</ul></div>
    </section>
    <section class="creative-forthcoming frame" id="creative-work" aria-labelledby="creative-work-title" data-creative-forthcoming><div><p>Selected work</p><h2 id="creative-work-title">Original work,<br />coming soon.</h2></div><p>Campaign and design pieces will appear here with my contribution and the context behind each project. The brand experience above is the current record of this side of my practice.</p></section>
    <section class="creative-closing frame" aria-labelledby="creative-closing-title"><div><p>For a creative brief or a new role</p><h2 id="creative-closing-title">Let’s make the<br />next idea count.</h2><a class="creative-contact" href="/contact/#direct-contact">Let’s talk <Arrow /></a></div><div class="creative-closing-links"><p>Take a closer look.</p><a href="/cv/#cv-creative">View the creative CV <Arrow /></a><a href="/software/">Explore software engineering <Arrow /></a></div></section>
  </div>
</Base>
<script>import { initCreativeExperience } from '../../scripts/creative-experience'; initCreativeExperience();</script>
<style>
  .creative-page { --ink:#26352d;--muted:#64705f;--line:#d0d8cb;--focus:#3b5c40;background:#f6f8f3;color:var(--ink); }
  :global(body[data-theme='creative']) { background:#f6f8f3; }
  :global(body[data-theme='creative'] .site-header) { --header-ground:#f6f8f3;--header-surface:#fcfdf9;--header-ink:#26352d;--header-muted:#64705f;--focus:#3b5c40; }
  :global(body[data-theme='creative'] .motion-toggle) { background:#f6f8f3;color:#26352d;border-color:#cbd5c7;border-radius:24px; }
  .creative-opening { position:relative;isolation:isolate;overflow:clip;display:grid;grid-template-rows:auto 1fr auto;gap:45px;min-height:700px;min-height:max(700px,95svh);padding-top:135px;padding-bottom:60px; }
  .creative-backdrop { position:absolute;inset:0;z-index:-1;pointer-events:none;background:#f6f8f3; }
  .creative-backdrop img,.creative-backdrop video { position:absolute;inset:0;width:100%;height:100%;object-fit:cover; }
  .creative-backdrop video { opacity:0;transition:opacity 500ms var(--ease-out); }
  .creative-opening[data-video-ready='true']:not([data-video-failed='true']) .creative-backdrop video { opacity:1; }
  .creative-backdrop::after { content:'';position:absolute;inset:0;background:linear-gradient(180deg,#f6f8f326,transparent 65%,#f6f8f3); }
  .creative-opening-meta { display:flex;justify-content:space-between;gap:30px;font-size:11px;line-height:1.7; }
  .creative-opening-meta > p:last-child { text-align:right; }
  .creative-opening-meta span { display:block;color:var(--muted); }
  .creative-opening h1 { align-self:center;font-size:clamp(76px,9.8vw,158px);font-weight:420;line-height:1.04;letter-spacing:-.065em;padding-block:.04em; }
  .creative-title-line { display:block;overflow:hidden;padding-bottom:.04em; }
  .creative-title-line > span { display:block; }
  .creative-title-line:last-child { text-align:right; }
  .creative-opening-bottom { display:flex;align-items:end;justify-content:space-between;gap:50px; }
  .creative-opening-bottom > p { max-width:340px;font-size:13px;line-height:1.85;color:var(--muted); }
  .creative-opening-bottom > div { display:flex;align-items:center;gap:32px; }
  .creative-explore { display:inline-flex;align-items:center;gap:23px;min-height:48px;font-size:11px; }
  .creative-explore > span { font-size:22px; }
  .creative-download { display:inline-flex;align-items:center;justify-content:space-between;gap:26px;min-height:50px;padding:13px 21px;border-radius:28px;background:#2c4934;color:#f9fcf5;font-size:11px; }
  .creative-download :global(.arrow-icon) { width:16px;height:16px; }
  :global(html[data-motion='playing']) .creative-title-line > span { animation:creative-type-in 850ms var(--ease-out) both; }
  :global(html[data-motion='playing']) .creative-title-line:last-child > span { animation-delay:80ms; }
  @keyframes creative-type-in { from { transform:translateY(105%); } to { transform:translateY(0); } }
  :global(html[data-motion='paused']) .creative-title-line > span { animation:none;transform:none; }
  .creative-contribution { display:grid;grid-template-columns:minmax(0,.65fr) minmax(0,1.25fr) minmax(0,1fr);gap:6%;align-items:center;background:#edf1e9;padding-block:clamp(65px,7vw,110px); }
  .creative-fanta-mark { min-width:0; }
  .creative-fanta-mark :global(.brand-mark) { width:min(100%,175px);height:auto;max-height:175px;object-fit:contain;object-position:left center; }
  .creative-fanta-mark > p { margin-top:24px;font-size:10px;color:var(--muted);line-height:1.7; }
  .creative-contribution-title > p { color:var(--muted);font-size:11px;margin-bottom:23px; }
  .creative-contribution-title h2 { font-size:clamp(36px,4vw,62px);font-weight:420;line-height:1.06;letter-spacing:-.05em; }
  .creative-contribution-copy { min-width:0; }
  .creative-contribution-copy h3 { font:500 clamp(20px,1.8vw,27px)/1.4 var(--display);letter-spacing:-.025em; }
  .creative-contribution-copy > p { color:var(--muted);font-size:12px;line-height:1.85;margin-top:20px;max-width:350px; }
  .creative-contribution-copy > a { display:inline-flex;align-items:center;gap:23px;min-height:44px;margin-top:15px;font-size:11px; }
  .creative-contribution-copy :global(.arrow-icon) { width:16px;height:16px; }
  .creative-practice { padding-block:clamp(75px,9vw,135px);background:#e8eee4; }
  .creative-practice > header { display:flex;align-items:end;justify-content:space-between;gap:60px;margin-bottom:60px; }
  .creative-practice h2 { font-size:clamp(42px,5vw,76px);font-weight:420;line-height:1.05; }
  .creative-practice > header > p { max-width:290px;font-size:13px;color:var(--muted);line-height:1.85; }
  .creative-services { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6%; }
  .creative-services > article { min-width:0;padding-top:25px;border-top:1px solid #b9c8b2; }
  .creative-services h3 { font-size:clamp(24px,2.4vw,37px);font-weight:430;line-height:1.1; }
  .creative-services p { max-width:330px;font-size:13px;color:var(--muted);line-height:1.85;margin-top:22px; }
  .creative-tools { display:flex;align-items:center;justify-content:space-between;gap:35px;margin-top:65px;padding-top:25px;border-top:1px solid #b9c8b2; }
  .creative-tools > p { font-size:11px;color:var(--muted); }
  .creative-tools ul { display:flex;flex-wrap:wrap;gap:15px 35px;font-size:13px; }
  .creative-forthcoming { display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:12%;align-items:center;padding-block:clamp(65px,8vw,115px);scroll-margin-top:20px; }
  .creative-forthcoming > div > p { font-size:11px;color:var(--muted);margin-bottom:25px; }
  .creative-forthcoming h2 { font-size:clamp(37px,4.1vw,63px);font-weight:420;line-height:1.07; }
  .creative-forthcoming > p { max-width:440px;font-size:13px;color:var(--muted);line-height:1.85; }
  .creative-closing { display:grid;grid-template-columns:minmax(0,1.45fr) minmax(0,.75fr);gap:12%;align-items:end;background:#101820;color:#edf1f2;--focus:#bfd2ff;padding-top:clamp(75px,8vw,125px);padding-bottom:75px; }
  .creative-closing > div > p { color:#a9bcc8;font-size:11px;line-height:1.7;margin-bottom:26px; }
  .creative-closing h2 { font-size:clamp(47px,5.6vw,86px);font-weight:410;line-height:1.04; }
  .creative-contact { display:inline-flex;align-items:center;justify-content:space-between;gap:55px;min-height:54px;padding:14px 23px;margin-top:32px;border-radius:30px;background:#edf2e8;color:#213123;font-size:12px; }
  .creative-contact :global(.arrow-icon) { width:17px;height:17px; }
  .creative-closing-links { padding-bottom:4px;min-width:0; }
  .creative-closing .creative-closing-links > p { margin-bottom:15px; }
  .creative-closing-links > a { display:flex;align-items:center;justify-content:space-between;gap:25px;min-height:52px;padding-block:12px;border-bottom:1px solid #41505a;font-size:12px;line-height:1.7; }
  .creative-closing-links :global(.arrow-icon) { width:16px;height:16px; }
  @media (hover:hover) and (pointer:fine) { .creative-explore:hover,.creative-contribution-copy > a:hover,.creative-closing-links > a:hover { text-decoration:underline;text-underline-offset:5px; }.creative-download:hover { background:#3b5c42; }.creative-contact:hover { background:#dce7d4; } }
  @media (max-width:1050px) { .creative-opening-bottom { gap:35px; }.creative-opening-bottom > div { flex-direction:column;align-items:end;gap:8px; }.creative-opening-bottom > p { max-width:290px;font-size:12px; }.creative-contribution { grid-template-columns:minmax(0,.75fr) minmax(0,1.35fr);gap:35px 9%; }.creative-contribution-copy { grid-column:2; }.creative-practice > header { gap:45px; } }
  @media (max-width:700px) {
    .creative-opening { min-height:100svh;padding-top:120px;padding-bottom:65px;gap:55px; }
    .creative-opening-meta { font-size:10px;gap:20px; }
    .creative-opening-meta > p:first-child { max-width:120px; }
    .creative-opening h1 { font-size:clamp(54px,12.8vw,82px);line-height:1.08; }
    .creative-backdrop img,.creative-backdrop video { object-position:20% center; }
    .creative-title-line:last-child { margin-top:12px; }
    .creative-opening-bottom { flex-direction:column;align-items:start;gap:28px; }
    .creative-opening-bottom > p { max-width:330px;font-size:12px; }
    .creative-opening-bottom > div { flex-direction:row;align-items:center;justify-content:space-between;width:100%;gap:20px; }
    .creative-explore { font-size:10px;gap:12px;max-width:145px; }
    .creative-download { font-size:10px;gap:15px;padding:12px 16px; }
    .creative-contribution { grid-template-columns:1fr;gap:30px;padding-block:60px; }
    .creative-fanta-mark { display:flex;align-items:center;gap:25px; }
    .creative-fanta-mark :global(.brand-mark) { width:105px;max-height:100px; }
    .creative-fanta-mark > p { margin-top:0;font-size:10px; }
    .creative-contribution-title > p { font-size:10px;margin-bottom:18px; }
    .creative-contribution-title h2 { font-size:clamp(40px,10vw,57px); }
    .creative-contribution-copy { grid-column:auto; }
    .creative-contribution-copy h3 { font-size:23px; }
    .creative-contribution-copy > p { font-size:12px;max-width:430px; }
    .creative-practice { padding-block:65px; }
    .creative-practice > header { display:block;margin-bottom:38px; }
    .creative-practice h2 { font-size:clamp(39px,9vw,58px); }
    .creative-practice > header > p { margin-top:25px;max-width:350px;font-size:12px; }
    .creative-services { grid-template-columns:1fr;gap:28px; }
    .creative-services > article { padding-top:22px; }
    .creative-services h3 { font-size:29px; }
    .creative-services p { margin-top:16px;font-size:12px;max-width:450px; }
    .creative-tools { align-items:start;flex-direction:column;gap:22px;margin-top:40px; }
    .creative-tools ul { gap:14px 25px;font-size:12px; }
    .creative-forthcoming { grid-template-columns:1fr;gap:25px;padding-block:60px; }
    .creative-forthcoming h2 { font-size:clamp(39px,9vw,57px); }
    .creative-forthcoming > p { font-size:12px;max-width:450px; }
    .creative-closing { grid-template-columns:1fr;gap:45px;padding-top:65px;padding-bottom:50px; }
    .creative-closing h2 { font-size:clamp(43px,10vw,63px); }
    .creative-closing > div > p { margin-bottom:23px; }
    .creative-closing-links { max-width:450px; }
  }
  @media (max-width:360px) { .creative-opening h1 { font-size:49px; }.creative-opening-bottom > div { align-items:start;flex-direction:column;gap:14px; }.creative-explore { max-width:none; }.creative-title-line:last-child { text-align:left; }.creative-fanta-mark { gap:20px; } }
  @media (prefers-reduced-motion:reduce) { .creative-backdrop video { display:none; }.creative-title-line > span { animation:none !important;transform:none; } }
</style>
