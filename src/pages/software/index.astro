---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import SoftwareGallery from '../../components/SoftwareGallery.astro';
import KineticForm from '../../components/KineticForm.astro';
---
<Base title="Software engineering" theme="software" description="Systems and websites by Joshua Ogallo. Explore commerce, people operations, payments, neonatal monitoring, finance and hospitality software.">
  <section class="page-heading frame software-heading">
    <p class="page-context">The software portfolio</p>
    <h1 data-reveal>Software<br />for people.</h1>
    <div class="heading-kinetic"><KineticForm /></div>
    <div class="heading-bottom"><p>Business systems, health software, and websites.<br />Built with people on the other side of the screen.</p><a class="text-link" href="/creative-marketing/">Looking for creative work? <Arrow diagonal={false} /></a></div>
  </section>
  <SoftwareGallery />
</Base>

<style>
  .heading-kinetic { position: absolute; width: clamp(280px,36vw,540px); top: 85px; right: 1%; }
  .software-heading h1,.software-heading .heading-bottom,.software-heading .page-context { position: relative; z-index: 1; }
  @media (max-width: 800px) { .heading-kinetic { width: 300px; right: -65px; top: 120px; opacity: .6; } }
  @media (max-width: 500px) { .heading-kinetic { width: 235px; right: -55px; top: 145px; opacity: .3; } }
</style>
