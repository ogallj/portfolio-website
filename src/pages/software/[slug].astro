---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import { projects } from '../../data/portfolio';
import { systemMockups } from '../../data/system-media';
import WebsiteCover from '../../components/WebsiteCover.astro';
import { websiteAssets, websiteMediaLabel } from '../../data/website-media';
export function getStaticPaths() { return projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, next: projects[(index + 1) % projects.length] } })); }
const { project, next } = Astro.props;
const mockup = project.mockup ? systemMockups[project.mockup] : undefined;
const website = project.website ? websiteAssets[project.website] : undefined;
---
<Base title={project.title} description={`${project.title}: ${project.summary} A ${project.kind === 'website' ? 'website' : 'software project'} in Joshua Ogallo's portfolio.`} theme="project">
  <section class:list={['project-heading', 'page-heading', 'frame', { 'project-heading--website': !!website }]}><a class="back-link" href={website ? `/software/?view=website#web-${project.slug}` : '/software/'}>← {website ? 'Website collection' : 'All software work'}</a><h1 data-reveal>{project.title}</h1><div class="heading-bottom"><p>{project.category}</p>{project.liveUrl && website?.liveStatus !== 'unavailable' && <a class="text-link" href={project.liveUrl} target="_blank" rel="noreferrer">{project.kind === 'system' ? 'Open project' : 'Visit website'} <Arrow /></a>}{website?.liveStatus === 'unavailable' && <span class="website-unavailable">Live site unavailable</span>}</div></section>
  {mockup ? <section class="system-presentation frame" aria-labelledby="overview-title">
    <figure class="system-figure"><ProjectCover project={project} priority sizes="(max-width: 850px) 100vw, 65vw" /><figcaption><span>Project interface mockup</span><a href={mockup.src} target="_blank" rel="noreferrer">View full mockup <Arrow /></a></figcaption></figure>
    <div class="system-context">
      <h2 id="overview-title">The project</h2>
      {project.status && <p class="system-status">{project.status}</p>}
      <p class="system-overview">{project.overview}</p>
      <ul class="system-focus">{project.focus.map(item => <li>{item}</li>)}</ul>
      <a class="text-link" href={`/contact/?topic=software&project=${encodeURIComponent(project.title)}`}>Discuss this project <Arrow diagonal={false} /></a>
    </div>
  </section> : website ? <section class="website-presentation frame" aria-labelledby="overview-title">
    <figure class="system-figure website-figure"><div class="website-detail-artboard" style={`background:${website.background}`}><WebsiteCover project={project} priority sizes="(max-width: 850px) 100vw, 65vw" /></div><figcaption><span>{websiteMediaLabel(website.kind, website.archived)}</span><a href={`/software/?view=website#web-${project.slug}`}>Explore the collection <Arrow /></a></figcaption></figure>
    <div class="system-context"><h2 id="overview-title">The website</h2><p class="system-overview">{project.overview}</p><ul class="system-focus">{project.focus.map(item => <li>{item}</li>)}</ul><a class="text-link" href={`/contact/?topic=software&project=${encodeURIComponent(project.title)}`}>Discuss this project <Arrow diagonal={false} /></a></div>
  </section> : <>
    <div class="project-hero-image frame" data-reveal><ProjectCover project={project} priority /></div>
    <section class="project-story section-space frame" aria-labelledby="overview-title"><div><h2 id="overview-title">The overview</h2><ul class="focus-list">{project.focus.map(item => <li>{item}</li>)}</ul></div><div><p class="project-overview" data-reveal>{project.overview}</p><p>For more about my contribution and the thinking behind this project, let’s talk.</p><a class="text-link" href={`/contact/?topic=software&project=${encodeURIComponent(project.title)}`}>Discuss this project <Arrow diagonal={false} /></a></div></section>
  </>}
  <section class="project-continuation section-space frame" aria-labelledby="next-project-title">
    <a href={`/software/${next.slug}/`}>
      <div class="continuation-copy"><p>Next project</p><h2 id="next-project-title">{next.title}</h2><span>{next.category}</span></div>
      {(next.mockup || next.website || next.image) && <div class="continuation-preview"><ProjectCover project={next} sizes="(max-width: 600px) 95px, 200px" /></div>}
      <Arrow />
    </a>
  </section>
</Base>

<style>
  .system-presentation,.website-presentation { display: grid; grid-template-columns: minmax(0,1.6fr) minmax(0,1fr); gap: clamp(35px,5vw,80px); align-items: start; padding-bottom: clamp(80px,10vw,150px); }
  .project-heading--website h1 { font-size: clamp(44px,6.5vw,104px); }
  .website-detail-artboard { padding: clamp(15px,2.6vw,40px); border-radius: 4px 42px 4px 4px; }
  .website-unavailable { font-size: 14px; color: var(--muted); }
  .system-figure { margin: 0; min-width: 0; }
  .system-figure figcaption { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 25px; padding-top: 20px; font-size: 12px; color: var(--muted); }
  .system-figure figcaption a { display: inline-flex; gap: 12px; min-height: 44px; align-items: center; color: var(--ink); font-weight: 650; }
  .system-figure figcaption :global(.arrow-icon) { width: 14px; height: 14px; }
  .system-context { padding-top: 8px; position: sticky; top: 55px; min-width: 0; }
  .system-context h2 { font-size: 21px; letter-spacing: -.025em; margin-bottom: 27px; }
  .system-overview { font-size: clamp(21px,2.25vw,34px); line-height: 1.38; letter-spacing: -.035em; }
  .system-status { display: inline-flex; align-items: center; gap: 8px; color: #29533f; font-size: 13px; font-weight: 650; margin-bottom: 20px; }
  .system-status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .system-focus { display: flex; flex-wrap: wrap; gap: 10px 19px; margin-top: 30px; padding-top: 24px; border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; }
  .system-context .text-link { margin-top: 30px; font-size: 14px; }
  .project-continuation { background: #dce6f4; }
  .project-continuation > a { display: flex; align-items: center; gap: clamp(25px,4vw,65px); }
  .continuation-copy { min-width: 0; flex: 1; }
  .continuation-copy p { font-size: 14px; margin-bottom: 22px; color: var(--muted); }
  .continuation-copy h2 { font-size: clamp(36px,5vw,78px); max-width: 750px; }
  .continuation-copy > span { display: block; font-size: 13px; color: var(--muted); margin-top: 23px; }
  .continuation-preview { width: clamp(120px,17vw,220px); flex: 0 0 auto; }
  .project-continuation > a > :global(.arrow-icon) { width: 38px; height: 38px; }
  @media (max-width: 850px) {
    .system-presentation,.website-presentation { grid-template-columns: 1fr; gap: 50px; }
    .system-context { position: static; max-width: 680px; }
    .system-overview { font-size: 28px; }
  }
  @media (max-width: 600px) {
    .system-presentation,.website-presentation { padding-bottom: 65px; gap: 37px; }
    .system-figure figcaption { font-size: 11px; padding-top: 12px; gap: 5px 15px; }
    .system-context h2 { font-size: 19px; margin-bottom: 23px; }
    .system-overview { font-size: 26px; }
    .system-focus { margin-top: 25px; }
    .project-continuation > a { flex-wrap: wrap; gap: 25px; }
    .continuation-copy { flex: 1 1 calc(100% - 120px); }
    .continuation-copy h2 { font-size: 34px; }
    .continuation-copy p { font-size: 12px; margin-bottom: 16px; }
    .continuation-copy > span { font-size: 11px; margin-top: 18px; }
    .continuation-preview { width: 95px; }
    .project-continuation > a > :global(.arrow-icon) { width: 26px; height: 26px; }
  }
</style>
