---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { experiences } from '../data/portfolio';
import { softwareResume, creativeResume } from '../data/resumes';
import BrandMark from '../components/BrandMark.astro';
import { experienceLogoIds } from '../data/brand-logos';
---
<Base title="About my practice" theme="about">
  <section class="about-hero page-heading frame"><div><p class="page-context">A little about the person</p><h1 data-reveal>Curiosity<br />at work.</h1><p class="about-opening">I’m Joshua Odero Ogallo, a software engineer and digital creative based in Nairobi, Kenya.</p></div><div class="about-portrait" data-reveal><img src="/images/joshua.webp" alt="Joshua Ogallo" width="800" height="1000" fetchpriority="high" /></div></section>
  <section class="about-narrative section-space frame" aria-labelledby="practice-title"><h2 id="practice-title" data-reveal>A practice<br />with two sides.</h2><div><p class="large-paragraph" data-reveal>I like making things work, and making them worth paying attention to.</p><p>My software work spans business systems and websites. My creative practice spans visual communication, brand content, and digital marketing. Each discipline has its own portfolio, with a shared attention to the people who use and experience the work.</p><p>I’ve worked across in-house engineering, agency creativity, digital marketing, and independent freelance projects.</p><div class="resume-links"><a href={softwareResume.pdf} class="text-link" download={softwareResume.pdfFilename}>Software CV <Arrow /></a><a href={creativeResume.pdf} class="text-link" download={creativeResume.pdfFilename}>Creative and marketing CV <Arrow /></a><a href="/cv/" class="text-link">Preview both CVs <Arrow /></a></div></div></section>
  <section class="experience-section section-space frame" aria-labelledby="experience-title"><div class="section-intro"><h2 id="experience-title">Where I’ve<br />built my practice.</h2><p>Experience across teams, agencies,<br />and independent work.</p></div><div class="experience-list">{experiences.map(experience => <article class="experience-row" data-reveal><div class="experience-identity">{experienceLogoIds[experience.company] && <BrandMark id={experienceLogoIds[experience.company]} />}<h3>{experience.company}</h3></div><div><h4>{experience.role}</h4><p>{experience.description}</p></div></article>)}</div></section>
  <section class="practice-switch frame"><p>Two perspectives. Plenty to explore.</p><div><a href="/software/">Software engineering <Arrow /></a><a href="/creative-marketing/">Creative & marketing <Arrow /></a></div></section>
</Base>

<style>
  .resume-links { display: flex; flex-wrap: wrap; gap: 8px 30px; }
</style>
