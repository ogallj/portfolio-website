---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import AboutExperience from '../components/AboutExperience.astro';
import { softwareResume, creativeResume } from '../data/resumes';
---
<Base title="About Joshua" theme="about" description="The person behind the work. Meet Joshua Ogallo, a software engineer and digital creative connecting frontend development, UI/UX and brand communication.">
  <div class="about-page" data-about-page>
    <section class="about-opening" data-about-opening aria-labelledby="about-title">
      <div class="about-backdrop" data-about-backdrop aria-hidden="true">
        <img src="/images/about/hero-poster.webp" alt="" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
        <video data-about-video muted loop playsinline preload="none" poster="/images/about/hero-poster.webp" tabindex="-1"><source src="/videos/about-hexagon.mp4" type="video/mp4" /></video>
      </div>
      <div class="about-opening-meta"><p>About Joshua Ogallo</p><p>Software engineer<br />Digital creative &amp; marketer</p></div>
      <h1 id="about-title"><span class="about-title-line"><span>Good work begins</span></span><span class="about-title-line"><span>with a curious mind.</span></span></h1>
      <div class="about-opening-bottom"><p>From the structure of an interface to the character of a brand, I care about what people experience.</p><a href="#person">Meet the person behind the work <span aria-hidden="true">↓</span></a></div>
    </section>
    <section class="about-person frame" aria-labelledby="person-title">
      <figure class="about-portrait" id="person" tabindex="-1"><img src="/images/joshua.webp" alt="Joshua Ogallo, wearing glasses and a navy jacket" width="1000" height="1250" loading="lazy" decoding="async" /><figcaption>Joshua Odero Ogallo</figcaption></figure>
      <div class="about-person-copy"><p class="about-section-label">A little introduction</p><h2 id="person-title">I’m Joshua.<br />Engineer. Creative.<br />Always curious.</h2><p class="about-person-lead">I build interfaces for business systems and websites, and create visual work for brand communication.</p><p class="about-person-body">My practice brings frontend engineering and UI/UX together with campaign ideation, brand content and digital marketing. I’m interested in the whole experience: how it works, what it communicates and the details that make it feel considered.</p><dl class="about-person-details"><div><dt>Based in</dt><dd>Kenya</dd></div><div><dt>Education</dt><dd>Software Engineering<br />Kisii University</dd></div></dl></div>
    </section>
    <section class="about-practice frame" aria-labelledby="practice-title">
      <div class="about-practice-heading"><h2 id="practice-title">Two disciplines.<br />A wider perspective.</h2><p>Different ways of making.<br />The same care for the outcome.</p></div>
      <div class="about-practice-pair">
        <article class="about-discipline"><p class="about-discipline-context">Interfaces &amp; experiences</p><h3>Software<br />engineering.</h3><p>I translate business requirements into responsive interfaces, working across the frontend and UI/UX of systems and websites.</p><ul aria-label="Software skills"><li>Next.js, React &amp; Angular</li><li>Responsive interfaces &amp; reusable components</li><li>REST APIs, Git &amp; GitHub</li></ul><a href="/software/">Explore software work <span><Arrow /></span></a></article>
        <article class="about-discipline"><p class="about-discipline-context">Ideas &amp; communication</p><h3>Creative &amp;<br />marketing.</h3><p>I develop campaign ideas, brand content and visual communication. My contributions include creative work and ideation for Fanta’s Skizia Utamu Challenge.</p><ul aria-label="Creative and marketing skills"><li>Campaign ideation &amp; digital marketing</li><li>Brand content &amp; visual communication</li><li>Photoshop, Illustrator, InDesign &amp; Affinity</li></ul><a href="/creative-marketing/">Explore creative work <span><Arrow /></span></a></article>
      </div>
    </section>
    <AboutExperience />
    <section class="about-resumes frame" aria-labelledby="resume-title"><div class="about-resume-heading"><h2 id="resume-title">Take the story<br />with you.</h2><p>Two focused CVs.<br />Choose the perspective that fits.</p><a href="/cv/">Preview both editions <Arrow diagonal={false} /></a></div><div class="about-resume-editions">{[softwareResume, creativeResume].map(resume => <article class="about-resume-edition"><p>{resume.role}</p><h3>{resume.title}</h3><div><a class="about-pdf" href={resume.pdf} download={resume.pdfFilename}>Download PDF <Arrow /></a><a href={resume.word} download={resume.wordFilename}>Word version</a></div></article>)}</div></section>
  </div>
</Base>
<script>import { initAboutExperience } from '../scripts/about-experience'; initAboutExperience();</script>
<style>
  .about-page { --ink:#262d2b;--muted:#626c66;--line:#d0d7d0;--focus:#3e5d4d;color:var(--ink);background:#f5f6f3; }
  :global(body[data-theme='about']) { background:#f5f6f3; }
  :global(body[data-theme='about'] .site-header) { --header-ground:#f5f6f3;--header-surface:#fafbf8;--header-ink:#262d2b;--header-muted:#626c66;--focus:#3e5d4d; }
  :global(body[data-theme='about'] .motion-toggle) { background:#f5f6f3;color:#262d2b;border-color:#c5cec5;border-radius:24px; }
  .about-opening { position:relative;isolation:isolate;display:grid;grid-template-rows:auto 1fr auto;gap:55px;min-height:740px;height:100svh;padding:135px var(--gutter) 62px;overflow:clip; }
  .about-backdrop { position:absolute;inset:0;z-index:-1;pointer-events:none;background:#f5f6f3; }
  .about-backdrop img,.about-backdrop video { position:absolute;inset:0;width:100%;height:100%;object-fit:cover; }
  .about-backdrop video { opacity:0;transition:opacity 500ms var(--ease-out); }
  .about-opening[data-video-ready='true']:not([data-video-failed='true']) .about-backdrop video { opacity:1; }
  .about-backdrop::after { content:'';position:absolute;inset:0;background:linear-gradient(180deg,#f5f6f32b,transparent 58%,#f5f6f3); }
  .about-opening-meta { display:flex;align-items:start;justify-content:space-between;gap:30px;font-size:11px;line-height:1.65; }
  .about-opening-meta > p:last-child { text-align:right;color:#58635b; }
  .about-opening h1 { align-self:center;font-size:clamp(60px,8.15vw,142px);font-weight:420;line-height:1.1;letter-spacing:-.065em;padding-bottom:.08em; }
  .about-title-line { display:block;overflow:hidden;padding-bottom:.04em; }
  .about-title-line > span { display:block; }
  .about-title-line:last-child { text-align:right; }
  .about-opening-bottom { display:flex;align-items:end;justify-content:space-between;gap:55px; }
  .about-opening-bottom > p { max-width:325px;font-size:13px;line-height:1.75;color:#566159; }
  .about-opening-bottom > a { display:inline-flex;align-items:center;justify-content:space-between;gap:35px;min-height:48px;font-size:11px; }
  .about-opening-bottom > a > span { font-size:23px; }
  :global(html[data-motion='playing']) .about-title-line > span { animation:about-type-in 850ms var(--ease-out) both; }
  :global(html[data-motion='playing']) .about-title-line:last-child > span { animation-delay:80ms; }
  @keyframes about-type-in { from { transform:translateY(105%); } to { transform:translateY(0); } }
  :global(html[data-motion='paused']) .about-title-line > span { animation:none;transform:none; }
  .about-person { display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(55px,10vw,170px);align-items:center;max-width:1600px;margin-inline:auto;padding-top:clamp(90px,10vw,155px);padding-bottom:clamp(100px,11vw,175px);scroll-margin-top:110px; }
  .about-portrait { min-width:0;scroll-margin-top:20px; }
  .about-portrait img { width:100%;height:auto;border-radius:4px; }
  .about-portrait figcaption { font-size:10px;color:var(--muted);padding-top:15px; }
  .about-person-copy { min-width:0;max-width:560px; }
  .about-section-label { font-size:11px;color:var(--muted);margin-bottom:30px; }
  .about-person-copy h2 { font-size:clamp(43px,4.5vw,73px);font-weight:420;line-height:1.06;letter-spacing:-.055em; }
  .about-person-body { font-size:13px;line-height:1.85;color:var(--muted);max-width:465px;margin-top:23px; }
  .about-person-lead { font-size:clamp(21px,1.9vw,28px);line-height:1.5;letter-spacing:-.025em;margin-top:35px; }
  .about-person-details { display:grid;grid-template-columns:1fr 1.4fr;gap:28px;margin:38px 0 0;padding-top:24px;border-top:1px solid var(--line);font-size:11px;line-height:1.7; }
  .about-person-details dt { color:var(--muted);font-size:10px;margin-bottom:8px; }
  .about-person-details dd { margin:0; }
  .about-practice { background:#e6ece5;padding-block:clamp(75px,8vw,125px); }
  .about-practice-heading { display:flex;align-items:end;justify-content:space-between;gap:55px;margin-bottom:75px; }
  .about-practice-heading h2 { font-size:clamp(40px,4.8vw,74px);font-weight:420;line-height:1.05; }
  .about-practice-heading > p { max-width:280px;font-size:12px;color:#5d695e;line-height:1.8; }
  .about-practice-pair { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12%; }
  .about-discipline { display:flex;flex-direction:column;align-items:start;min-width:0;border-top:1px solid #b9c7b7;padding-top:27px; }
  .about-discipline-context { font-size:10px;color:#5b685c;margin-bottom:30px; }
  .about-discipline h3 { font-size:clamp(38px,4.2vw,66px);font-weight:420;line-height:1.07;letter-spacing:-.05em; }
  .about-discipline > p:not(.about-discipline-context) { max-width:440px;font-size:13px;line-height:1.85;color:#59665a;margin-top:25px; }
  .about-discipline ul { margin-top:24px;margin-bottom:30px;color:#4e5e4f;font-size:11px;line-height:1.8; }
  .about-discipline li + li { margin-top:7px; }
  .about-discipline > a { display:inline-flex;align-items:center;gap:30px;min-height:48px;margin-top:auto;font-size:12px; }
  .about-discipline > a > span { display:grid;place-items:center;width:43px;aspect-ratio:1;border:1px solid #aaba9f;border-radius:50%; }
  .about-discipline :global(.arrow-icon) { width:15px;height:15px;transition:transform 180ms var(--ease-out); }

  .about-resumes { display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.35fr);gap:10%;padding-block:clamp(65px,7vw,110px);background:#dce5df; }
  .about-resume-heading h2 { font-size:clamp(39px,4.1vw,64px);font-weight:420;line-height:1.06; }
  .about-resume-heading > p { color:#54645a;font-size:12px;line-height:1.8;margin-top:22px; }
  .about-resume-heading > a { display:inline-flex;align-items:center;gap:22px;min-height:48px;margin-top:18px;font-size:11px; }
  .about-resume-heading :global(.arrow-icon) { width:16px;height:16px; }
  .about-resume-editions { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:45px;align-items:center; }
  .about-resume-edition { min-width:0;border-top:1px solid #aebfb2;padding-top:25px;align-self:stretch;display:flex;flex-direction:column; }
  .about-resume-edition > p { font-size:10px;color:#536457;line-height:1.7;margin-bottom:24px; }
  .about-resume-edition h3 { font-size:clamp(26px,2.7vw,41px);font-weight:430;letter-spacing:-.045em;line-height:1.08;margin-bottom:40px; }
  .about-resume-edition > div { display:flex;flex-direction:column;align-items:start;gap:5px;margin-top:auto; }
  .about-resume-edition a { display:inline-flex;align-items:center;gap:25px;min-height:44px;font-size:11px; }
  .about-resume-edition .about-pdf { font-weight:650; }
  .about-resume-edition :global(.arrow-icon) { width:16px;height:16px; }
  @media (hover:hover) and (pointer:fine) { .about-opening-bottom > a:hover,.about-resume-heading > a:hover,.about-resume-edition a:hover { text-decoration:underline;text-underline-offset:5px; }.about-discipline > a:hover :global(.arrow-icon) { transform:translate(2px,-2px); } }
  @media (max-width:1050px) { .about-person { gap:7%; }.about-person-copy h2 { font-size:4.7vw; }.about-resumes { gap:7%;grid-template-columns:minmax(0,.8fr) minmax(0,1.4fr); }.about-resume-editions { gap:28px; } }
  @media (max-width:800px) { .about-person { align-items:start; }.about-person-copy h2 { font-size:5vw; }.about-person-lead { font-size:20px;margin-top:25px; }.about-person-body { font-size:12px; }.about-person-details { grid-template-columns:1fr;gap:20px;margin-top:26px; }.about-resumes { grid-template-columns:1fr;gap:40px; }.about-resume-edition h3 { font-size:35px; }.about-resume-editions { gap:50px; } }
  @media (max-width:650px) {
    .about-opening { height:auto;min-height:100svh;padding:118px var(--gutter) 60px;gap:65px; }
    .about-opening-meta { font-size:10px;gap:20px; }
    .about-opening-meta > p:first-child { max-width:115px; }
    .about-opening h1 { font-size:clamp(40px,8.8vw,58px);line-height:1.16;letter-spacing:-.055em; }
    .about-title-line:last-child { margin-top:10px;text-align:left;max-width:95%; }
    .about-opening-bottom { flex-direction:column;align-items:start;gap:24px; }
    .about-opening-bottom > p { max-width:310px;font-size:12px; }
    .about-opening-bottom > a { font-size:10px;gap:25px; }
    .about-person { grid-template-columns:1fr;gap:40px;padding-top:70px;padding-bottom:75px; }
    .about-portrait { width:86%;max-width:450px; }
    .about-person-copy { max-width:500px; }
    .about-section-label { margin-bottom:23px; }
    .about-person-copy h2 { font-size:clamp(40px,9.3vw,58px); }
    .about-person-lead { font-size:23px; }
    .about-person-body { font-size:13px; }
    .about-person-details { grid-template-columns:1fr 1.4fr;margin-top:30px; }
    .about-practice { padding-block:65px; }
    .about-practice-heading { display:block;margin-bottom:40px; }
    .about-practice-heading h2 { font-size:clamp(38px,8.7vw,54px); }
    .about-practice-heading > p { margin-top:25px;font-size:12px; }
    .about-practice-pair { grid-template-columns:1fr;gap:50px; }
    .about-discipline { padding-top:23px; }
    .about-discipline-context { margin-bottom:24px; }
    .about-discipline h3 { font-size:clamp(41px,10vw,60px); }
    .about-discipline > p:not(.about-discipline-context) { margin-top:23px; }
    .about-discipline ul { margin-bottom:22px; }

    .about-resumes { padding-block:65px; }
    .about-resume-heading h2 { font-size:clamp(41px,9vw,56px); }
    .about-resume-editions { gap:28px; }
    .about-resume-edition > p { min-height:34px;font-size:10px;margin-bottom:20px; }
    .about-resume-edition h3 { font-size:clamp(24px,5.8vw,34px);margin-bottom:28px; }
    .about-resume-edition a { gap:15px;font-size:10px; }
  }
  @media (max-width:360px) { .about-opening { gap:50px; }.about-opening h1 { font-size:37px; }.about-portrait { width:100%; }.about-person-details { gap:20px; }.about-resume-editions { grid-template-columns:1fr;gap:30px; }.about-resume-edition > p { min-height:0;margin-bottom:15px; }.about-resume-edition h3 { font-size:31px;margin-bottom:20px; }.about-resume-edition > div { flex-direction:row;flex-wrap:wrap;gap:0 25px; } }
  @media (min-width:651px) and (max-height:700px) { .about-opening { min-height:650px;padding-top:120px;padding-bottom:45px; }.about-opening h1 { font-size:7.8vw; } }
  @media (prefers-reduced-motion:reduce) { .about-title-line > span { animation:none !important;transform:none; }.about-backdrop video { display:none; }.about-discipline :global(.arrow-icon) { transition:none; } }
</style>
