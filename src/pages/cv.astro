---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { resumes } from '../data/resumes';
---
<Base title="CVs & résumés" theme="cv" footerVariant="compact" description="Joshua Ogallo’s experience, on paper. View and download the software engineering or creative and marketing CV, in PDF and editable Word formats.">
  <div class="cv-page" data-cv-page>
    <header class="cv-introduction frame"><p>CVs &amp; résumés</p><div><h1>Experience, on paper.</h1><p>Two focused editions. Choose the perspective that fits your next opportunity.</p></div></header>
    <section class="cv-editions frame" id="cv-documents" aria-label="CV editions and downloads">
      {resumes.map(resume => <article class="cv-edition" id={'edition-' + resume.id} aria-labelledby={'cv-' + resume.id}>
        <p class="cv-role">{resume.role}</p><h2 id={'cv-' + resume.id}>{resume.title}</h2><p class="cv-description">{resume.description}</p>
        <div class="cv-file-actions"><a class="cv-download" href={resume.pdf} download={resume.pdfFilename} aria-label={'Download ' + resume.title + ' CV, PDF'}>Download PDF <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a><a class="cv-word" href={resume.word} download={resume.wordFilename} aria-label={'Download ' + resume.title + ' CV, editable Word document'}>Word (.docx)</a></div>
        <div class="cv-file-details"><p>{resume.pages === 1 ? 'One page' : resume.pages + ' pages'}<span>PDF, {resume.pdfKB} KB</span></p><a href={'#document-' + resume.id} aria-label={'Preview the ' + resume.title + ' CV below'}>Preview <span aria-hidden="true">↓</span></a></div>
      </article>)}
    </section>
    <section class="cv-reading-room frame" aria-label="Complete CV previews">
      {resumes.map(resume => <figure class="cv-document" id={'document-' + resume.id} aria-label={resume.title + ' CV preview'}>
        <a class="cv-view" href={resume.pdf} target="_blank" rel="noreferrer" aria-label={'View ' + resume.title + ' CV, PDF (opens in a new tab)'}><span class="cv-paper"><img src={resume.previewLarge} srcset={resume.previewSmall + ' 400w, ' + resume.preview + ' 800w, ' + resume.previewLarge + ' 1600w'} sizes="(max-width: 700px) calc(100vw - 44px), (max-width: 1100px) 40vw, 470px" width={resume.previewLargeWidth} height={resume.previewLargeHeight} alt="" loading="lazy" decoding="async" /></span><span class="cv-caption"><span>{resume.title}</span><span>Open PDF <Arrow /></span></span></a>
        <a class="cv-portfolio" href={resume.portfolio}>{resume.id === 'software' ? 'View software portfolio' : 'View creative portfolio'} <Arrow diagonal={false} /></a>
      </figure>)}
    </section>
    <div class="cv-conversation frame"><p>A role, a project, a new conversation.</p><a href="/contact/">Let’s talk <Arrow /></a></div>
  </div>
</Base>
<style>
  .cv-page { --ink:#26352c;--muted:#657163;--focus:#365940;background:#f6f8f3;color:var(--ink); }
  :global(body[data-theme='cv']) { background:#f6f8f3; }
  :global(body[data-theme='cv'] .site-header) { --header-ground:#f6f8f3;--header-surface:#fcfdf9;--header-ink:#26352c;--header-muted:#657163;--focus:#365940; }
  :global(body[data-theme='cv'] .motion-toggle) { background:#f6f8f3;color:#26352c;border-color:#cbd5c7;border-radius:24px; }
  .cv-introduction { padding-top:clamp(135px,11vw,175px);padding-bottom:55px; }
  .cv-introduction > p { color:var(--muted);font-size:11px;margin-bottom:24px; }
  .cv-introduction > div { display:grid;grid-template-columns:minmax(0,1fr) 270px;align-items:end;gap:6%; }
  .cv-introduction h1 { font-size:clamp(49px,5.75vw,88px);font-weight:420;line-height:1.06;letter-spacing:-.06em; }
  .cv-introduction > div > p { max-width:270px;color:var(--muted);font-size:13px;line-height:1.85;padding-bottom:4px; }
  .cv-editions { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(40px,7vw,112px);padding-bottom:45px;scroll-margin-top:20px; }
  .cv-edition { display:flex;flex-direction:column;min-width:0;border-top:1px solid #cfd8ca;padding-top:26px;scroll-margin-top:20px; }
  .cv-role { color:var(--muted);font-size:11px;line-height:1.6;margin-bottom:14px; }
  .cv-edition h2 { font-size:clamp(29px,3vw,44px);font-weight:430;line-height:1.1;letter-spacing:-.045em;scroll-margin-top:20px; }
  .cv-description { max-width:430px;font-size:13px;line-height:1.85;color:var(--muted);margin-top:20px;margin-bottom:27px; }
  .cv-file-actions { display:flex;align-items:center;flex-wrap:wrap;gap:14px 25px;margin-top:auto; }
  .cv-file-actions > a { display:inline-flex;align-items:center;justify-content:space-between;gap:28px;min-height:48px;font-size:11px; }
  .cv-download { background:#2c4934;color:#f9fcf5;border-radius:28px;padding:13px 21px; }
  .cv-word { text-decoration:underline;text-underline-offset:5px; }
  .cv-file-details { display:flex;align-items:center;justify-content:space-between;gap:25px;margin-top:19px; }
  .cv-file-details > p { display:flex;flex-wrap:wrap;gap:7px 22px;color:var(--muted);font-size:10px;line-height:1.7; }
  .cv-file-details > a { display:inline-flex;align-items:center;gap:14px;min-height:44px;font-size:10px; }
  .cv-file-details > a > span { font-size:17px; }
  .cv-reading-room { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(40px,7vw,112px);background:#e6ece3;padding-top:48px;padding-bottom:40px; }
  .cv-document { min-width:0;max-width:470px;width:100%;margin-inline:auto;scroll-margin-top:20px; }
  .cv-view { display:block; }
  .cv-paper { display:block;background:white;border:1px solid #d2dbcc;box-shadow:0 12px 28px #233a2810; }
  .cv-paper img { display:block;width:100%;height:auto;object-fit:contain; }
  .cv-view .cv-caption { display:flex;align-items:center;justify-content:space-between;gap:20px;padding-block:18px;min-height:62px;font-size:11px;line-height:1.6; }
  .cv-view .cv-caption > span:last-child { display:inline-flex;align-items:center;gap:17px;white-space:nowrap; }
  .cv-view :global(.arrow-icon) { width:16px;height:16px; }
  .cv-portfolio { display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:48px;border-top:1px solid #bdcbb5;font-size:11px;color:#52664b; }
  .cv-portfolio :global(.arrow-icon) { width:16px;height:16px; }
  .cv-conversation { display:flex;align-items:center;justify-content:space-between;gap:40px;padding-top:45px;padding-bottom:65px;background:#e6ece3;border-top:1px solid #ccd7c4; }
  .cv-conversation > p { font:420 clamp(24px,2.7vw,39px)/1.2 var(--display);letter-spacing:-.04em;max-width:650px; }
  .cv-conversation > a { display:inline-flex;align-items:center;justify-content:space-between;gap:45px;min-height:52px;padding:13px 22px;border:1px solid #9daf93;border-radius:28px;font-size:11px;white-space:nowrap; }
  .cv-conversation :global(.arrow-icon) { width:17px;height:17px; }
  @media (hover:hover) and (pointer:fine) { .cv-download:hover { background:#3b5c42; }.cv-word:hover,.cv-file-details > a:hover,.cv-view:hover figcaption > span:last-child,.cv-portfolio:hover { text-decoration:underline;text-underline-offset:5px; }.cv-conversation > a:hover { background:#dce5d7; } }
  @media (max-width:1100px) { .cv-introduction > div { grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:8%; }.cv-introduction h1 { font-size:6.4vw; }.cv-editions,.cv-reading-room { gap:6%; }.cv-edition h2 { font-size:3.4vw; } }
  @media (max-width:800px) { .cv-introduction > div { grid-template-columns:1fr;gap:25px; }.cv-introduction h1 { font-size:clamp(47px,7.6vw,65px); }.cv-introduction > div > p { max-width:420px; }.cv-edition h2 { font-size:29px; }.cv-description { font-size:12px; }.cv-file-actions { gap:12px 18px; }.cv-file-actions > a { gap:18px; } }
  @media (max-width:700px) {
    .cv-introduction { padding-top:122px;padding-bottom:38px; }
    .cv-introduction > p { margin-bottom:23px;font-size:10px; }
    .cv-introduction h1 { max-width:490px;font-size:clamp(45px,10.4vw,61px);line-height:1.08; }
    .cv-introduction > div > p { font-size:12px;max-width:340px; }
    .cv-editions { grid-template-columns:1fr;gap:30px;padding-bottom:35px; }
    .cv-edition { padding-top:23px; }
    .cv-role { font-size:10px;margin-bottom:12px; }
    .cv-edition h2 { font-size:clamp(28px,7.2vw,39px); }
    .cv-description { max-width:450px;margin-top:18px;margin-bottom:22px;font-size:12px; }
    .cv-file-actions { gap:17px 25px; }
    .cv-file-actions > a { min-height:48px;font-size:11px;gap:24px; }
    .cv-file-details { margin-top:13px; }
    .cv-reading-room { grid-template-columns:1fr;gap:40px;padding-top:32px;padding-bottom:28px; }
    .cv-document { max-width:470px; }
    .cv-view .cv-caption { font-size:10px;gap:17px;min-height:58px; }
    .cv-view .cv-caption > span:last-child { gap:12px; }
    .cv-portfolio { font-size:10px; }
    .cv-conversation { align-items:start;flex-direction:column;gap:25px;padding-top:35px;padding-bottom:55px; }
    .cv-conversation > p { font-size:clamp(27px,7vw,37px);max-width:330px; }
  }
  @media (max-width:360px) { .cv-introduction h1 { font-size:43px; }.cv-file-actions { gap:12px 20px; }.cv-file-actions > a { gap:15px; }.cv-download { padding-inline:18px; }.cv-file-details > p { gap:5px 12px; }.cv-view .cv-caption { align-items:start; }.cv-view .cv-caption > span:first-child { max-width:150px; } }
</style>
