---
import Base from '../layouts/Base.astro';
import RefractionExperience from '../components/RefractionExperience.astro';
import Arrow from '../components/Arrow.astro';
---
<Base title="Software engineer & digital creative" theme="home" description="Joshua Ogallo — frontend software engineer, digital creative and marketer. Explore interfaces, websites, brand experience and two distinct portfolios.">
  <RefractionExperience />
  <section class="home-perspective frame" aria-labelledby="home-perspective-title">
    <div class="perspective-opening" data-enter><p>The person behind the work</p><h2 id="home-perspective-title">A builder’s mind.<br />A creative’s eye.</h2></div>
    <div class="perspective-record"><p class="perspective-description" data-enter>I’m Joshua Ogallo. I work across frontend engineering, UI/UX, visual communication and digital marketing—connecting how a business works with how people experience it.</p><div class="perspective-experience"><span>Experience across</span><p>Baruchsoft Technologies<br />Socialmeds · Ogre Digital<br />Independent freelance work</p></div><a class="text-link" href="/about/">Meet the person <Arrow /></a><a class="text-link" href="/cv/">Choose a CV <Arrow /></a></div>
    <div class="perspective-edge" aria-hidden="true" data-parallax-surface></div>
  </section>
  <script>
    import { initRefractionStudy } from '../scripts/refraction-director';
    const root = document.querySelector<HTMLElement>('[data-refraction-study]');
    if (root) initRefractionStudy(root);
  </script>
</Base>
<style>
  .home-perspective { position: relative; isolation: isolate; overflow: hidden; background: #dae4e7; display: grid; grid-template-columns: 1.2fr 1fr; gap: 11%; padding-block: clamp(85px,12vw,185px); }
  .perspective-opening > p { font-size: 12px; color: #52626a; margin-bottom: 30px; }
  .perspective-opening h2 { font-size: clamp(45px,5.4vw,87px); line-height: 1.04; }
  .perspective-record { padding-top: 45px; }
  .perspective-description { font-size: clamp(20px,2vw,29px); letter-spacing: -.025em; line-height: 1.5; max-width: 490px; }
  .perspective-experience { display: grid; grid-template-columns: .7fr 1.3fr; gap: 25px; margin-top: 38px; padding-top: 28px; border-top: 1px solid #9eb0b777; font-size: 12px; }
  .perspective-experience > span { color: #52626a; }
  .perspective-experience p { line-height: 1.9; }
  .perspective-record .text-link { margin-top: 30px; margin-right: 30px; font-size: 12px; }
  .perspective-edge { position: absolute; z-index: -1; top: -20%; left: 38%; bottom: -25%; width: 15%; transform: skewX(-24deg); border-left: 1px solid #f6fcffbb; background: linear-gradient(90deg,#c0d1d530,#fff4 30%,#9ebfc344 90%,#d3dfdd00); }
  @media (max-width:700px) { .home-perspective { grid-template-columns: 1fr; gap: 35px; } .perspective-record { padding-top: 0; } .perspective-description { font-size: 21px; } .perspective-experience { grid-template-columns: 1fr 1.5fr; } .perspective-edge { left: 55%; width: 30%; } }
</style>
