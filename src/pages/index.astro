---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import ProjectCover from '../components/ProjectCover.astro';
import { projects } from '../data/portfolio';
const mcc = projects.find(p => p.slug === 'mcc-church-management')!;
const websites = projects.filter(p => p.kind === 'website').slice(0,3);
---
<Base title="Software engineer & digital creative" theme="home">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-intro"><p>Software engineer.<br />Digital creative & marketer.</p><p class="hero-location">Based in Nairobi.<br />Working across disciplines.</p><a href="#practices" class="text-link">Explore my work <Arrow diagonal={false} /></a></div>
    <div class="sculpture-stage" data-scene aria-hidden="true">
      <svg class="sculpture-fallback" viewBox="0 0 600 600" fill="none"><g transform="rotate(-22 300 300)"><path d="M227 120v255c0 90-140 90-140 0" stroke="#1746ff" stroke-width="54" stroke-linecap="round"/><rect x="285" y="130" width="175" height="290" rx="87" stroke="#a3b9db" stroke-width="52" transform="rotate(14 372 275)"/></g></svg>
    </div>
    <h1 id="hero-title" class="hero-name"><span class="hero-first">Joshua</span><span class="hero-last">OGALLO<span class="name-period">.</span></span></h1>
    <div class="hero-bottom"><span>Software engineering × Digital expression</span><a href="#practices" aria-label="Scroll to the two portfolios"><span>Scroll to explore</span><svg width="18" height="24" viewBox="0 0 18 24" fill="none" aria-hidden="true"><path d="M9 1v20m-7-7 7 7 7-7" stroke="currentColor" stroke-width="1.5"/></svg></a></div>
  </section>

  <section class="practices section-space frame" id="practices" aria-labelledby="practices-title">
    <div class="section-intro"><h2 id="practices-title" data-reveal>Two practices.<br />One curious mind.</h2><p data-reveal>I build the systems behind a business and shape how it shows up in the world. Explore each side of my work.</p></div>
    <div class="practice-grid">
      <a class="practice-panel practice-software" href="/software/" data-reveal>
        <div class="practice-heading"><h3>Software<br />engineering</h3><span class="practice-arrow"><Arrow /></span></div>
        <div class="software-art" aria-hidden="true"><span class="art-bracket">{`{`}</span><span class="art-cross">+</span><span class="art-bracket">{`}`}</span></div>
        <p>Business systems, digital products<br />and websites.</p><span class="practice-bottom">Explore software work <Arrow diagonal={false} /></span>
      </a>
      <a class="practice-panel practice-creative" href="/creative-marketing/" data-reveal>
        <div class="practice-heading"><h3>Creative<br />& marketing</h3><span class="practice-arrow"><Arrow /></span></div>
        <div class="creative-art" aria-hidden="true"><span>Make</span><span>an</span><span>impression.</span></div>
        <p>Visual communication, brand content<br />and digital marketing.</p><span class="practice-bottom">Explore creative work <Arrow diagonal={false} /></span>
      </a>
    </div>
  </section>

  <section class="work-preview section-space" aria-labelledby="work-preview-title">
    <div class="frame section-intro"><h2 id="work-preview-title" data-reveal>Built for<br />the real world.</h2><div><p>From business operations to public-facing websites. A closer look at the software side.</p><a class="text-link" href="/software/">All software work <Arrow diagonal={false} /></a></div></div>
    <a href={`/software/${mcc.slug}/`} class="featured-product frame" data-reveal>
      <div class="featured-image"><ProjectCover project={mcc} /></div><div class="featured-caption"><div><h3>MCC Church Management</h3><p>Church administration</p></div><span class="round-link small"><Arrow /></span></div>
    </a>
    <div class="website-strip frame">{websites.map(project => <a href={`/software/${project.slug}/`} class="website-teaser" data-reveal><div class="teaser-image"><img src={project.image} alt={`${project.title} website screenshot`} width="700" height="440" loading="lazy" decoding="async" /></div><div><h3>{project.title}</h3><Arrow /></div></a>)}</div>
  </section>

  <section class="about-preview section-space frame" aria-labelledby="about-preview-title">
    <div class="portrait-composition" data-reveal><img src="/images/joshua.webp" alt="Joshua Ogallo" width="800" height="1000" loading="lazy" /><span class="portrait-caption">A person behind the pixels.</span></div>
    <div class="about-preview-copy"><h2 id="about-preview-title" data-reveal>Both sides<br />of the screen.</h2><p data-reveal>My work moves between frontend engineering and digital creativity. I bring a builder’s attention to how things work, and a creative’s eye to how they feel.</p><p data-reveal>Experience across Baruchsoft Technologies, Socialmeds, Ogre Digital, and independent freelance work.</p><a class="text-link" href="/about/">More about my practice <Arrow diagonal={false} /></a></div>
  </section>
</Base>
