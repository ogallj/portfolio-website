---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import ProjectCover from '../components/ProjectCover.astro';
import { projects } from '../data/portfolio';
const featuredSystem = projects.find(p => p.slug === 'b-commerce')!;
const websites = projects.filter(p => p.kind === 'website').slice(0,3);
---
<Base title="Software engineer & digital creative" theme="home">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-intro"><p>Software engineer.<br />Digital creative & marketer.</p><p class="hero-location">Based in Nairobi.<br />Working across disciplines.</p><a href="#practices" class="text-link">Explore my work <Arrow diagonal={false} /></a></div>
    <div class="hero-orbit" aria-hidden="true"><span></span><span></span><i></i></div>
    <div class="sculpture-stage" data-scene aria-hidden="true">
      <svg class="sculpture-fallback" viewBox="0 0 600 600" fill="none"><g transform="rotate(-22 300 300)"><path d="M227 120v255c0 90-140 90-140 0" stroke="#1746ff" stroke-width="54" stroke-linecap="round"/><rect x="285" y="130" width="175" height="290" rx="87" stroke="#a3b9db" stroke-width="52" transform="rotate(14 372 275)"/></g></svg>
    </div>
    <h1 id="hero-title" class="hero-name"><span class="hero-first">Joshua</span><span class="hero-last">OGALLO<span class="name-period">.</span></span></h1>
    <div class="hero-bottom"><span>Software engineering × Digital expression</span><a href="#practices" aria-label="Scroll to the two portfolios"><span>Scroll to explore</span><svg width="18" height="24" viewBox="0 0 18 24" fill="none" aria-hidden="true"><path d="M9 1v20m-7-7 7 7 7-7" stroke="currentColor" stroke-width="1.5"/></svg></a></div>
  </section>

  <section class="practices section-space frame" id="practices" aria-labelledby="practices-title">
    <div class="section-intro"><h2 id="practices-title" data-reveal>Two practices.<br />One curious mind.</h2><p data-reveal>I build the systems behind a business and shape how it shows up in the world. Explore each side of my work.</p></div>
    <div class="practice-grid">
      <a class="practice-panel practice-software" href="/software/" data-reveal>
        <div class="practice-heading"><h3>Software<br />engineering</h3><span class="practice-arrow"><Arrow /></span></div>
        <div class="practice-art-depth" data-depth-art aria-hidden="true"><div class="practice-art-pointer" data-motion-pointer><div class="software-art"><span class="art-bracket">{`{`}</span><span class="art-cross">+</span><span class="art-bracket">{`}`}</span></div></div></div>
        <p>Business systems, digital products<br />and websites.</p><span class="practice-bottom">Explore software work <Arrow diagonal={false} /></span>
      </a>
      <a class="practice-panel practice-creative" href="/creative-marketing/" data-reveal>
        <div class="practice-heading"><h3>Creative<br />& marketing</h3><span class="practice-arrow"><Arrow /></span></div>
        <div class="practice-art-depth" data-depth-art aria-hidden="true"><div class="practice-art-pointer" data-motion-pointer><div class="creative-art"><span>Make</span><span>an</span><span>impression.</span></div></div></div>
        <p>Visual communication, brand content<br />and digital marketing.</p><span class="practice-bottom">Explore creative work <Arrow diagonal={false} /></span>
      </a>
    </div>
  </section>

  <section class="work-preview section-space" aria-labelledby="work-preview-title">
    <div class="frame section-intro"><h2 id="work-preview-title" data-reveal>Built for<br />the real world.</h2><div><p>From business operations to public-facing websites. A closer look at the software side.</p><a class="text-link" href="/software/">All software work <Arrow diagonal={false} /></a></div></div>
    <a href={`/software/${featuredSystem.slug}/`} class="home-system-feature frame" data-reveal>
      <div class="home-system-visual"><div class="system-depth-planes" data-depth-planes aria-hidden="true"><span></span><span></span><span></span></div><ProjectCover project={featuredSystem} sizes="(max-width: 700px) 100vw, 65vw" /></div>
      <div class="home-system-copy"><p>{featuredSystem.category}</p><h3>{featuredSystem.title}</h3><p>{featuredSystem.summary}</p><span class="home-system-action">Explore project <span class="round-link small"><Arrow /></span></span></div>
    </a>
    <div class="website-strip frame">{websites.map(project => <a href={`/software/${project.slug}/`} class="website-teaser" data-reveal><div class="teaser-image"><ProjectCover project={project} sizes="(max-width: 600px) 100vw, 33vw" /></div><div><h3>{project.title}</h3><Arrow /></div></a>)}</div>
  </section>

  <section class="about-preview section-space frame" aria-labelledby="about-preview-title">
    <div class="portrait-composition" data-reveal><div class="portrait-window"><img src="/images/joshua.webp" alt="Joshua Ogallo" width="800" height="1000" loading="lazy" data-parallax-image /></div><span class="portrait-caption">A person behind the pixels.</span></div>
    <div class="about-preview-copy"><h2 id="about-preview-title" data-reveal>Both sides<br />of the screen.</h2><p data-reveal>My work moves between frontend engineering and digital creativity. I bring a builder’s attention to how things work, and a creative’s eye to how they feel.</p><p data-reveal>Experience across Baruchsoft Technologies, Socialmeds, Ogre Digital, and independent freelance work.</p><a class="text-link" href="/about/">More about my practice <Arrow diagonal={false} /></a></div>
  </section>
</Base>

<style>
  .home-system-feature { display: grid; grid-template-columns: minmax(0,1.6fr) minmax(0,1fr); gap: clamp(35px,5vw,80px); align-items: center; }
  .home-system-visual { min-width: 0; position: relative; perspective: 1200px; isolation: isolate; }
  .home-system-visual > :global(.project-cover) { position: relative; z-index: 1; }
  .system-depth-planes { position: absolute; inset: 4% 0; transform-style: preserve-3d; z-index: -1; }
  .system-depth-planes span { position: absolute; inset: 0; background: #1746ff; border: 1px solid #6084ff; }
  .system-depth-planes span:nth-child(1) { transform: translateZ(-80px) translate(-3%,-3%); opacity: .12; }
  .system-depth-planes span:nth-child(2) { transform: translateZ(-40px) translate(3%,3%); opacity: .2; }
  .system-depth-planes span:nth-child(3) { transform: translateZ(0) translate(-2%,2%); opacity: .1; }
  .home-system-copy { min-width: 0; }
  .home-system-copy > p:first-child { font-size: 14px; color: var(--muted); margin-bottom: 20px; }
  .home-system-copy h3 { font-size: clamp(40px,5.2vw,80px); line-height: 1.02; }
  .home-system-copy > p:nth-of-type(2) { font-size: 18px; color: var(--muted); margin-top: 26px; max-width: 300px; }
  .home-system-action { display: flex; align-items: center; justify-content: space-between; gap: 25px; font-size: 14px; font-weight: 650; margin-top: 45px; }
  @media (max-width: 700px) {
    .home-system-feature { grid-template-columns: 1fr; gap: 28px; }
    .home-system-copy h3 { font-size: 43px; }
    .home-system-copy > p:first-child { font-size: 13px; margin-bottom: 12px; }
    .home-system-copy > p:nth-of-type(2) { margin-top: 18px; font-size: 16px; }
    .home-system-action { margin-top: 25px; }
  }
</style>
