---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { profile } from '../data/portfolio';
import SpatialExperience from '../components/SpatialExperience.astro';
---
<Base title="Let’s talk" theme="contact" footer={false} description="Contact Joshua Ogallo about software engineering, creative and marketing projects, or professional opportunities.">
  <SpatialExperience kind="contact" title={['Let’s', 'talk.']} description="A project, an opportunity, or a conversation worth starting. Tell me what you have in mind." assets={[]} poster="" actions={[{ href: 'mailto:' + profile.email, label: 'Email Joshua' }, { href: '#direct-contact', label: 'Use the inquiry form' }]} target="#direct-contact" hold={.5} />
  <section class="direct-contact frame" id="direct-contact" tabindex="-1" aria-labelledby="direct-email-title">
    <div class="direct-details">
      <h2 id="direct-email-title">Reach me directly.</h2>
      <a class="direct-email" href={'mailto:' + profile.email}>{profile.email} <Arrow /></a>
      <button type="button" class="direct-copy" data-copy-email data-email={profile.email}>Copy email address <span aria-hidden="true">+</span></button><p class="direct-copy-status" data-copy-status role="status"></p>
      <div class="direct-profiles"><a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn <Arrow /></a><a href={profile.github} target="_blank" rel="noreferrer">GitHub <Arrow /></a><a href="/cv/">CVs & résumés <Arrow /></a></div>
      <div class="direct-location"><span>Based in</span><p>{profile.location}</p></div>
      <div class="direct-practices"><a href="/software/">Software engineering</a><a href="/creative-marketing/">Creative & marketing</a></div>
    </div>
    <form class="direct-form" data-inquiry-form>
      <h2>Tell me what you have in mind.</h2>
      <div class="direct-field-pair"><div class="direct-field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required maxlength="120" placeholder="Your name" /></div><div class="direct-field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@example.com" /></div></div>
      <div class="direct-field"><label for="topic">What’s on your mind?</label><select id="topic" name="topic" required><option value="" disabled selected>Choose a conversation</option><option>Software project</option><option>Creative & marketing</option><option>Opportunity</option><option>Something else</option></select></div>
      <div class="direct-field"><label for="message">A little about it</label><textarea id="message" name="message" rows="5" required maxlength="5000" placeholder="The idea, the brief, or the role you have in mind."></textarea></div>
      <div class="direct-submit"><p>This opens a draft in your email app. You review and send it from there.</p><button class="button-primary" type="submit" data-inquiry-submit disabled>Open email draft <Arrow /></button></div><p class="direct-form-status" role="status" data-form-status></p>
      <noscript><p>You can email <a href={'mailto:' + profile.email}>{profile.email}</a> directly.</p></noscript>
    </form>
  </section>
  <div class="direct-signoff frame"><a href="/">Joshua Ogallo <Arrow /></a><span>Software engineer. Digital creative.</span></div>
</Base>
<style>
  .direct-contact { display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(40px,7vw,110px);padding-top:clamp(55px,7vw,105px);padding-bottom:clamp(75px,9vw,135px);background:#e8eeeb;scroll-margin-top:85px; }
  .direct-details { padding-top:25px;min-width:0; }.direct-details h2 { font-family:var(--display);font-size:clamp(29px,3vw,45px);letter-spacing:-.04em;font-weight:450;line-height:1.15; }
  .direct-email { display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:clamp(22px,2.5vw,38px);letter-spacing:-.045em;line-height:1.2;margin-top:24px;min-height:52px;overflow-wrap:anywhere; }.direct-email :global(.arrow-icon) { width:25px;height:25px;flex-shrink:0; }
  .direct-copy { background:none;border:0;padding:0;font-size:12px;min-height:44px;display:inline-flex;align-items:center;gap:17px; }.direct-copy span { font-size:20px; }.direct-copy-status { font-size:12px;color:var(--muted);min-height:20px;margin-top:2px; }
  .direct-profiles { display:flex;flex-wrap:wrap;gap:0 28px;margin-top:28px; }.direct-profiles a { display:inline-flex;align-items:center;gap:12px;min-height:44px;font-size:13px;font-weight:600; }.direct-profiles :global(.arrow-icon) { width:14px;height:14px; }
  .direct-location { padding-block:30px;margin-top:30px;border-top:1px solid var(--line); }.direct-location span { font-size:11px;color:var(--muted); }.direct-location p { font-size:17px;margin-top:5px; }.direct-practices { display:grid;gap:5px; }.direct-practices a { font-size:13px;min-height:44px;display:inline-flex;align-items:center;width:fit-content; }
  .direct-form { padding:clamp(28px,3.8vw,58px);background:var(--paper);min-width:0; }.direct-form h2 { font-size:clamp(27px,2.6vw,40px);font-weight:450;line-height:1.12;max-width:400px;margin-bottom:35px; }
  .direct-field-pair { display:grid;grid-template-columns:1fr 1fr;gap:25px; }.direct-field { min-width:0;margin-bottom:26px; }.direct-field label { display:block;font-size:12px;font-weight:650;margin-bottom:6px; }
  .direct-field input,.direct-field select,.direct-field textarea { width:100%;border:0;border-bottom:1px solid #aebfc5;border-radius:0;background:transparent;color:var(--ink);padding:12px 0;font-size:16px;line-height:1.5;min-height:49px; }.direct-field input::placeholder,.direct-field textarea::placeholder { color:#64767e; }.direct-field textarea { min-height:130px;resize:vertical; }
  .direct-field input:focus-visible,.direct-field select:focus-visible,.direct-field textarea:focus-visible { outline:2px solid var(--blue);outline-offset:5px;border-color:var(--blue); }.direct-field select option { color:var(--ink);background:var(--paper); }
  .direct-submit > p { font-size:12px;color:var(--muted);max-width:350px;margin-bottom:22px; }.direct-submit .button-primary { min-height:54px;padding:15px 20px;gap:40px;font-size:13px; }.direct-form-status { font-size:12px;color:var(--muted);margin-top:18px; }
  .direct-form noscript p { font-size:13px;margin-top:20px; }.direct-form noscript a { text-decoration:underline; }
  .direct-signoff { display:flex;align-items:center;justify-content:space-between;gap:25px;padding-block:27px 70px;border-top:1px solid var(--line); }.direct-signoff a { display:inline-flex;align-items:center;gap:20px;min-height:44px;font-size:24px;font-family:var(--display);letter-spacing:-.04em; }.direct-signoff :global(.arrow-icon) { width:19px;height:19px; }.direct-signoff > span { color:var(--muted);font-size:12px; }
  @media (hover:hover) and (pointer:fine) { .direct-email:hover,.direct-copy:hover,.direct-profiles a:hover,.direct-practices a:hover,.direct-signoff a:hover { text-decoration:underline;text-underline-offset:5px; } }
  @media (max-width:1050px) { .direct-contact { gap:35px; }.direct-form { padding:28px; }.direct-field-pair { grid-template-columns:1fr;gap:0; }.direct-email { font-size:27px; } }
  @media (max-width:750px) { .direct-contact { grid-template-columns:1fr;gap:37px; }.direct-details { padding-top:0; }.direct-email { font-size:clamp(22px,5.8vw,36px);max-width:470px; }.direct-profiles { margin-top:15px; }.direct-location { margin-top:18px;padding-block:22px; }.direct-practices { display:flex;flex-wrap:wrap;gap:0 25px; }.direct-form { padding:28px 24px; }.direct-form h2 { font-size:32px;max-width:320px; }.direct-signoff { align-items:start;flex-direction:column;gap:5px; }.direct-signoff > span { max-width:250px; }.direct-submit .button-primary { width:100%; } }
  @media (max-width:360px) { .direct-form { padding:27px 20px; }.direct-form h2 { font-size:28px; }.direct-profiles { gap:0 20px; } }
</style>
