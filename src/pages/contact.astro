---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { profile } from '../data/portfolio';
---
<Base title="Let’s talk" theme="contact" footer={false} description="Contact Joshua Ogallo about software engineering, creative and marketing projects, or professional opportunities.">
  <div class="contact-page" data-contact-page>
    <section class="contact-opening frame" aria-labelledby="contact-title">
      <div class="contact-introduction">
        <h1 id="contact-title">Let’s talk.</h1>
        <div class="contact-invitation"><p>A software project, a creative brief, or a new role. I’d like to hear what you have in mind.</p><a href="#direct-contact">Start a conversation <Arrow diagonal={false} /></a></div>
      </div>
      <div class="contact-email-row">
        <a class="direct-email" href={'mailto:' + profile.email} aria-label={'Email Joshua at ' + profile.email}>{profile.email}<Arrow /></a>
        <div class="contact-copy"><button type="button" class="direct-copy" data-copy-email data-email={profile.email}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M15 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h2" /></svg>Copy email address</button><p class="direct-copy-status" data-copy-status role="status"></p></div>
      </div>
    </section>

    <section class="direct-contact frame" id="direct-contact" tabindex="-1" aria-labelledby="inquiry-title">
      <div class="contact-context">
        <div><h2 id="inquiry-title">Tell me<br />what’s next.</h2><p>Share the brief, the problem you’re solving or the role you’re hiring for.</p></div>
      </div>
      <form class="direct-form" data-inquiry-form aria-labelledby="inquiry-title">
        <p class="contact-form-intro">A few details to get us started. All fields are required.</p>
        <div class="direct-field-pair">
          <div class="direct-field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required maxlength="120" placeholder="Your name" /></div>
          <div class="direct-field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@example.com" /></div>
        </div>
        <div class="direct-field"><label for="topic">What would you like to discuss?</label><select id="topic" name="topic" required><option value="" disabled selected>Choose a conversation</option><option>Software project</option><option>Creative &amp; marketing</option><option>Opportunity</option><option>Something else</option></select></div>
        <div class="direct-field direct-field--message"><label for="message">A little about it</label><textarea id="message" name="message" rows="4" required maxlength="5000" placeholder="The idea, the brief, or the role you have in mind."></textarea></div>
        <div class="direct-submit"><p id="draft-explanation">This opens a draft in your email app.<br />You review and send it from there.</p><button class="contact-submit" type="submit" data-inquiry-submit disabled aria-describedby="draft-explanation">Open email draft <Arrow /></button></div>
        <p class="direct-form-status" role="status" data-form-status></p>
        <noscript><p class="contact-noscript">You can email <a href={'mailto:' + profile.email}>{profile.email}</a> directly.</p></noscript>
      </form>
      <div class="contact-connections"><p>Elsewhere</p><nav aria-label="Professional profiles"><a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn <Arrow /></a><a href={profile.github} target="_blank" rel="noreferrer">GitHub <Arrow /></a><a href="/cv/">CVs &amp; résumés <Arrow /></a></nav><p class="contact-location">{profile.location}</p></div>
    </section>

    <footer class="direct-signoff frame">
      <div class="contact-signature"><a href="/">Joshua Ogallo</a><p>Software engineer. Digital creative.</p></div>
      <nav aria-label="Explore the portfolio"><a href="/software/">Software engineering</a><a href="/creative-marketing/">Creative &amp; marketing</a><a href="#main">Back to top <Arrow diagonal={false} /></a></nav>
    </footer>
  </div>
</Base>
<style>
  .contact-page { --ink:#26312b;--muted:#5b685e;--line:#cbd4c8;--focus:#365c40;background:#f2f4f0;color:var(--ink); }
  :global(body[data-theme='contact']) { background:#f2f4f0;--focus:#365c40; }
  :global(body[data-theme='contact'] .site-header) { --header-ground:#f2f4f0;--header-surface:#fbfcf9;--header-ink:#26312b;--header-muted:#5b685e;--header-active:#e3e9df; }
  :global(body[data-theme='contact'] .motion-toggle) { --focus:#365c40;background:#f2f4f0;color:#26312b;border-color:#cbd4c8;border-radius:24px; }
  .contact-page ::selection { background:#d2dfca;color:#26312b; }
  .contact-opening { padding-top:clamp(155px,15vw,220px);padding-bottom:65px; }
  .contact-introduction { display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,.8fr);align-items:end;gap:7%; }
  .contact-introduction h1 { font-size:clamp(88px,12.7vw,184px);font-weight:430;line-height:.98;letter-spacing:-.04em;white-space:nowrap; }
  .contact-invitation { padding-bottom:8px; }
  .contact-invitation > p { max-width:320px;font-size:15px;line-height:1.8;color:var(--muted); }
  .contact-invitation > a { display:inline-flex;align-items:center;gap:26px;min-height:44px;margin-top:20px;font-size:12px;font-weight:550; }
  .contact-invitation :global(.arrow-icon) { width:18px;height:18px;transform:rotate(90deg); }
  .contact-email-row { display:flex;align-items:center;justify-content:space-between;gap:35px;margin-top:75px;padding-block:30px 16px;border-top:1px solid var(--line); }
  .direct-email { display:inline-flex;align-items:center;gap:28px;min-width:0;min-height:60px;font-family:var(--display);font-size:clamp(28px,4.25vw,64px);font-weight:430;line-height:1.25;letter-spacing:-.035em;overflow-wrap:anywhere; }
  .direct-email :global(.arrow-icon) { width:clamp(24px,3.1vw,44px);height:auto;flex-shrink:0; }
  .contact-copy { flex:0 0 auto;align-self:center;position:relative; }
  .direct-copy { display:inline-flex;align-items:center;gap:12px;min-height:48px;border:0;background:transparent;padding:5px 0;font-size:12px; }
  .direct-copy svg { width:19px;height:19px;flex-shrink:0; }
  .direct-copy-status { position:absolute;right:0;top:100%;width:260px;font-size:11px;line-height:1.6;text-align:right;color:var(--muted); }
  .direct-contact { display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.35fr);column-gap:12%;row-gap:40px;padding-top:85px;padding-bottom:95px;background:#fbfcf9;scroll-margin-top:15px; }
  .contact-context { min-width:0;grid-column:1;grid-row:1; }
  .contact-context h2 { max-width:360px;font-size:clamp(40px,4.5vw,65px);font-weight:430;line-height:1.06;letter-spacing:-.04em; }
  .contact-context > div > p { max-width:280px;margin-top:25px;font-size:14px;line-height:1.85;color:var(--muted); }
  .contact-connections { grid-column:1;grid-row:2;align-self:end; }
  .contact-connections > p:first-child { font-size:12px;color:var(--muted); }
  .contact-connections nav { display:flex;flex-direction:column;align-items:start;margin-top:12px; }
  .contact-connections a { display:inline-flex;justify-content:space-between;align-items:center;gap:40px;min-width:175px;min-height:44px;font-size:13px; }
  .contact-connections :global(.arrow-icon) { width:15px;height:15px; }
  .contact-connections .contact-location { margin-top:23px;font-size:12px;color:var(--muted); }
  .direct-form { min-width:0;grid-column:2;grid-row:1 / span 2; }
  .contact-form-intro { font-size:12px;line-height:1.7;color:var(--muted);margin-bottom:32px; }
  .direct-field-pair { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:30px; }
  .direct-field { min-width:0;margin-bottom:28px; }
  .direct-field label { display:block;margin-bottom:8px;font-size:12px;font-weight:600;line-height:1.6; }
  .direct-field input,.direct-field select,.direct-field textarea { width:100%;min-width:0;min-height:51px;padding:10px 0 14px;border:0;border-bottom:1px solid #a9b8a6;border-radius:0;background:transparent;color:var(--ink);font-size:16px;line-height:1.6;caret-color:#365c40; }
  .direct-field input::placeholder,.direct-field textarea::placeholder { color:#697367;opacity:1; }
  .direct-field input:focus-visible,.direct-field select:focus-visible,.direct-field textarea:focus-visible { outline:2px solid var(--focus);outline-offset:5px;border-color:var(--focus); }
  .direct-field select { cursor:pointer;padding-right:10px; }
  .direct-field select option { background:#fbfcf9;color:#26312b; }
  .direct-field textarea { min-height:135px;resize:vertical; }
  .direct-field--message { margin-bottom:30px; }
  .direct-submit { display:flex;align-items:center;justify-content:space-between;gap:25px; }
  .direct-submit > p { font-size:11px;line-height:1.8;color:var(--muted); }
  .contact-submit { display:inline-flex;align-items:center;justify-content:space-between;gap:36px;min-height:54px;padding:15px 22px;border:0;border-radius:30px;background:#304c39;color:#fbfcf9;font-size:12px;font-weight:550;white-space:nowrap;transition:background 180ms ease; }
  .contact-submit :global(.arrow-icon) { width:18px;height:18px; }
  .contact-submit:disabled { opacity:.5;cursor:not-allowed; }
  .direct-form-status { min-height:20px;margin-top:18px;color:var(--muted);font-size:12px;line-height:1.7; }
  .contact-noscript { font-size:13px;line-height:1.8;margin-top:15px; }
  .contact-noscript a { text-decoration:underline;text-underline-offset:4px; }
  .direct-signoff { display:flex;align-items:center;justify-content:space-between;gap:40px;padding-top:37px;padding-bottom:75px;background:#f2f4f0; }
  .contact-signature > a { display:inline-flex;align-items:center;min-height:44px;font-family:var(--display);font-size:24px;font-weight:500;letter-spacing:-.035em; }
  .contact-signature > p { color:var(--muted);font-size:11px;line-height:1.7;margin-top:3px; }
  .direct-signoff nav { display:flex;align-items:center;gap:35px; }
  .direct-signoff nav a { display:inline-flex;align-items:center;gap:14px;min-height:44px;font-size:11px; }
  .direct-signoff :global(.arrow-icon) { width:15px;height:15px;transform:rotate(-90deg); }
  @media (hover:hover) and (pointer:fine) { .direct-email:hover,.direct-copy:hover,.contact-invitation a:hover,.contact-connections a:hover,.direct-signoff a:hover { text-decoration:underline;text-underline-offset:6px;text-decoration-thickness:1px; }.contact-submit:not(:disabled):hover { background:#42634b; } }
  @media (max-width:1050px) { .contact-introduction { grid-template-columns:minmax(0,1.4fr) minmax(0,.9fr);gap:7%; }.contact-introduction h1 { font-size:clamp(88px,12vw,125px); }.contact-invitation > p { font-size:14px; }.direct-contact { column-gap:8%;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr); }.direct-field-pair { gap:22px; }.direct-submit { align-items:start;flex-direction:column;gap:20px; }.direct-signoff nav { gap:22px; } }
  @media (max-width:750px) { .contact-opening { padding-top:140px;padding-bottom:47px; }.contact-introduction { grid-template-columns:1fr;gap:30px; }.contact-introduction h1 { font-size:clamp(74px,20vw,135px); }.contact-invitation { padding:0;max-width:440px; }.contact-invitation > p { max-width:390px;font-size:14px; }.contact-invitation > a { margin-top:12px; }.contact-email-row { align-items:start;flex-direction:column;gap:10px;margin-top:35px;padding-top:23px;padding-bottom:0; }.direct-email { gap:17px;font-size:clamp(24px,6.4vw,44px);min-height:48px;letter-spacing:-.03em; }.direct-email :global(.arrow-icon) { width:22px; }.contact-copy { align-self:start; }.direct-copy { font-size:11px; }.direct-copy-status { position:static;text-align:left;min-height:18px;width:auto;max-width:300px; }.direct-contact { grid-template-columns:1fr;gap:35px;padding-top:50px;padding-bottom:55px; }.contact-context { grid-column:1;grid-row:1; }.contact-context h2 { font-size:45px; }.contact-context > div > p { max-width:380px;margin-top:19px;font-size:13px; }.direct-form { grid-column:1;grid-row:2; }.contact-connections { grid-column:1;grid-row:3;padding-top:25px;border-top:1px solid var(--line); }.contact-connections > p:first-child { margin-top:0;font-size:11px; }.contact-connections nav { flex-direction:row;flex-wrap:wrap;gap:0 26px;margin-top:6px; }.contact-connections a { min-width:0;font-size:12px;gap:12px; }.contact-connections .contact-location { font-size:11px;margin-top:12px; }.contact-form-intro { margin-bottom:26px;font-size:11px; }.direct-submit { gap:22px; }.contact-submit { min-width:220px; }.direct-signoff { align-items:start;flex-direction:column;gap:24px;padding-top:25px;padding-bottom:85px; }.contact-signature > a { font-size:23px; }.direct-signoff nav { flex-wrap:wrap;gap:0 24px; }.direct-signoff nav a { font-size:11px; } }
  @media (max-width:460px) { .direct-field-pair { grid-template-columns:1fr;gap:0; }.direct-field { margin-bottom:25px; }.contact-submit { width:100%; }.contact-connections nav { gap:0 20px; } }
  @media (max-width:360px) { .contact-introduction h1 { font-size:67px; }.direct-email { font-size:23px;gap:11px; }.direct-email :global(.arrow-icon) { width:18px; }.direct-signoff nav { flex-direction:column;align-items:start;gap:0; } }
</style>
